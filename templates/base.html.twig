<!DOCTYPE html>
<html lang="es">
    <head>
        <meta charset="UTF-8">
        <title>{% block title %}Inicio{% endblock %}</title>
        <meta name="viewport" content="width=device-width, initial-scale=1">

        {% block meta %}
            <meta name="description" content="{{ plataforma.nombre }}">
            <meta property="og:image" content="{{ absolute_url(asset('img/'~ plataforma.logo)) }}" />
        {% endblock %}

        <meta property="og:url" content="{{ absolute_url(path('app_inicio')) }}" />

        <link rel="icon" href="{{  absolute_url(asset('/'~ plataforma.icono)) }}">



        {% block stylesheets %}
            <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">

            <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
            <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">

            <link rel="preconnect" href="https://fonts.googleapis.com">
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
            <link href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&family=Raleway:ital,wght@0,100..900;1,100..900&family=Ubuntu:ital,wght@0,300;0,400;0,500;0,700;1,300;1,400;1,500;1,700&display=swap" rel="stylesheet">

            <link rel="stylesheet" href="{{ asset('css/theme.css') }}">
        {% endblock %}

        {% block javascripts %}
            <script src="https://code.jquery.com/jquery-3.2.1.min.js" ></script>
            <script src="{{ asset('bundles/fosjsrouting/js/router.min.js') }}"></script>
            <script src="{{ path('fos_js_routing_js', { callback: 'fos.Router.setData' }) }}"></script>
            {% block importmap %}{{ importmap('app') }}{% endblock %}
            <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js" integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r" crossorigin="anonymous"></script>

            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>

            <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
            <script src="{{ asset('base.js') }}"></script>
            <script src="https://sdk.mercadopago.com/js/v2"></script>
        {% endblock %}
    </head>
    <body>
    {% set usuario = usuario is defined ? usuario : app.user %}
    {% set tradMenu = plataforma.getTraduccionMenu(idiomaPlataforma.codigo) %}
    <header class="shadow-sm">
        <nav class="navbar navbar-expand-lg toa-navbar">
            <div class="container">
                <a class="navbar-brand d-flex align-items-center" href="{{ path('app_inicio') }}">
                    <img src="{{ asset('img/'~ plataforma.logo) }}" alt="{{ plataforma.nombre }}">
                    <span class="fw-semibold ms-2 text-uppercase text-nowrap text-primary">{{ plataforma.nombre }}</span>
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent"
                        aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarSupportedContent">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 align-items-lg-center">
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') == 'app_inicio' ? 'active' : '' }}" href="{{ path('app_inicio') }}">{{ tradMenu['menu:inicio']}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_inicio') }}#bookings">{{ tradMenu['menu:reservas']}}</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link {{ app.request.attributes.get('_route') starts with 'app_destino' ? 'active' : '' }}" href="{{ path('app_destinos') }}">Destinos</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" href="{{ path('app_ayuda') }}">{{ tradMenu['menu:faks']}}</a>
                        </li>
                    </ul>
                    <div class="d-flex flex-column flex-lg-row gap-3 align-items-lg-center ms-lg-4">
                        <div class="dropdown">
                            <button type="button" class="btn btn-outline-secondary btn-sm dropdown-toggle px-3" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false" id="lang-seceted-dropdown">
                                <img src="{{ asset(icon_language  ~ '/'  ~ idiomaPlataforma.icono ) }}" alt="{{ idiomaPlataforma.nombre }}" class="me-2" style="height: 1rem">{{ idiomaPlataforma.nombre }}
                            </button>
                            <div class="dropdown-menu dropdown-menu-end shadow-sm">
                                {% for idioma in idiomas %}
                                    <button class="dropdown-item d-flex align-items-center gap-2" type="button" onclick="changelan({{ idioma.id }})">
                                        <img src="{{ asset(icon_language  ~ '/'  ~ idioma.icono ) }}" alt="{{ idioma.nombre }}" style="height: 1rem"> {{ idioma.nombre }}
                                    </button>
                                {% endfor %}
                            </div>
                        </div>
                        <div class="dropdown">
                            <button class="btn btn-dark dropdown-toggle px-3" data-bs-toggle="dropdown" aria-expanded="false">
                                {%  if not usuario %}
                                    Usuario
                                {% else %}
                                    {{ usuario.nombre }}
                                {% endif %}
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-menu-dark shadow">
                                {%  if not usuario %}
                                    <li><a class="dropdown-item" href="{{ path('app_login') }}">Ingresar</a></li>
                                    <li><a class="dropdown-item" href="{{ path('app_register') }}">Crear cuenta</a></li>
                                {% else %}
                                    {% if 'ROLE_ADMIN' in usuario.roles  %}
                                        <li><a class="dropdown-item" href="{{ path('app_administrador_home') }}">Panel de administración</a></li>
                                    {% endif %}
                                    {% if 'ROLE_PARTNER' in usuario.roles %}
                                        <li><a class="dropdown-item" href="{{ path('app_booking_partner') }}">Panel de partner</a></li>
                                    {% endif %}
                                    {% if 'ROLE_DRIVER' in usuario.roles %}
                                        <li><a class="dropdown-item" href="{{ path('app_driver_dashboard') }}">Panel de chofer</a></li>
                                    {% endif %}
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="{{ path('app_logout') }}">Cerrar sesión</a></li>
                                {% endif %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <main>
        {% block body %}{% endblock %}
    </main>
    <footer class="toa-footer">
        <div class="container">
            <div class="row gy-4">
                <div class="col-md-4">
                    <h6>{{ plataforma.nombre }}</h6>
                    <p class="small mb-1">{{ plataforma.descripcionCorta ?? 'Tu agencia integral para explorar Iguazú con reservas seguras y traslados confiables.' }}</p>
                    <div class="toa-social-links">
                        {% if plataforma.linkInstagram != '' %}
                            <a href="{{ plataforma.linkInstagram }}" target="_blank" aria-label="Instagram"><span class="bi bi-instagram"></span></a>
                        {% endif %}
                        {% if plataforma.linkWhatsapp != '' %}
                            <a href="{{ plataforma.linkWhatsapp }}" target="_blank" aria-label="WhatsApp"><span class="bi bi-whatsapp"></span></a>
                        {% endif %}
                    </div>
                </div>
                <div class="col-md-4">
                    <h6>Navegación</h6>
                    <ul class="list-unstyled small mb-0">
                        <li class="mb-2"><a href="{{ path('app_inicio') }}">Inicio</a></li>
                        <li class="mb-2"><a href="{{ path('app_inicio') }}#bookings">Reservas</a></li>
                        <li class="mb-2"><a href="{{ path('app_destinos') }}">Destinos</a></li>
                        <li class="mb-2"><a href="{{ path('app_transfers') }}">Traslados</a></li>
                        <li class="mb-2"><a href="{{ path('app_ayuda') }}">Preguntas frecuentes</a></li>
                    </ul>
                </div>
                <div class="col-md-4">
                    <h6>Contacto</h6>
                    <ul class="list-unstyled small mb-0">
                        {% if plataforma.contactoTelefono != '' %}<li class="mb-2"><span class="bi bi-telephone me-2"></span>{{ plataforma.contactoTelefono }}</li>{% endif %}
                        {% if plataforma.contactoCorreo != '' %}<li class="mb-2"><span class="bi bi-envelope me-2"></span>{{ plataforma.contactoCorreo }}</li>{% endif %}
                        {% if plataforma.contactoDireccion != '' %}<li class="mb-2"><span class="bi bi-geo-alt me-2"></span>{{ plataforma.contactoDireccion }}</li>{% endif %}
                    </ul>
                </div>
            </div>
            <div class="toa-footer-bottom">
                <span>© {{ "now"|date('Y') }} {{ plataforma.nombre }} · Desarrollado por <a href="https://shophardware.com.ar" target="_blank" rel="noopener">Shop Hardware</a></span>
            </div>
        </div>
    </footer>
    <script>
        AOS.init();
    </script>
    </body>
</html>
