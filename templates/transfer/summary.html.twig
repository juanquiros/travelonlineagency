{% extends 'base.html.twig' %}

{% block title %}Resumen de traslado{% endblock %}

{% block body %}
<section class="container py-5">
    <h1 class="mb-4">Resumen de tu traslado</h1>
    <div class="row g-4">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Datos del pasajero</h2>
                    <ul class="list-unstyled">
                        <li><strong>Nombre:</strong> {{ solicitud.nombrePasajero }}</li>
                        <li><strong>Correo:</strong> {{ solicitud.emailPasajero }}</li>
                        {% if solicitud.telefonoPasajero %}
                            <li><strong>Teléfono:</strong> {{ solicitud.telefonoPasajero }}</li>
                        {% endif %}
                        {% if solicitud.cantidadPasajeros %}
                            <li><strong>Cantidad de pasajeros:</strong> {{ solicitud.cantidadPasajeros }}</li>
                        {% endif %}
                        {% if solicitud.vueloPasajero %}
                            <li><strong>Número de vuelo:</strong> {{ solicitud.vueloPasajero }}</li>
                        {% endif %}
                        <li><strong>Tipo de vehículo solicitado:</strong> {{ solicitud.tipoVehiculo ?: 'No especificado' }}</li>
                        {% if solicitud.codigoServicio %}
                            <li><strong>Orden de servicio:</strong> {{ solicitud.codigoServicio }}</li>
                        {% endif %}
                    </ul>
                    <h2 class="h5 mt-3">Itinerario</h2>
                    <ul class="list-group list-group-flush">
                        {% for destino in solicitud.destinos %}
                            <li class="list-group-item">{{ destino.destino.nombre }}</li>
                        {% else %}
                            <li class="list-group-item text-muted">Aún no se registraron destinos.</li>
                        {% endfor %}
                    </ul>
                    {% set totals = solicitud.totalesPorMoneda %}
                    <div class="mt-3">
                        <div><strong>Inicio del servicio:</strong> {{ solicitud.arribo ? solicitud.arribo|date('d/m/Y H:i') : 'Sin dato' }}</div>
                        <div><strong>Fin del servicio:</strong> {{ solicitud.salida ? solicitud.salida|date('d/m/Y H:i') : 'Sin dato' }}</div>
                    </div>
                    <div class="mt-4">
                        <h2 class="h6 text-uppercase text-muted">Tarifa del traslado</h2>
                        <p class="mb-1"><strong>Importe confirmado:</strong> {{ solicitud.moneda }} {{ solicitud.precioTotal|number_format(2, ',', '.') }}</p>
                        {% if totals is iterable and totals is not empty %}
                            <p class="small text-muted mb-1">Valores de referencia en otras monedas:</p>
                            <ul class="list-unstyled small mb-0">
                                {% for iso, amount in totals %}
                                    <li>{{ iso }} {{ amount|number_format(2, ',', '.') }}{% if iso == solicitud.moneda %} (seleccionada){% endif %}</li>
                                {% endfor %}
                            </ul>
                        {% endif %}
                    </div>
                    <div class="mt-3">
                        <strong>Estado:</strong> {% include 'administrador/transfer/status_badge.html.twig' with {estado: solicitud.estado} %}
                    </div>
                    {% if asignacion %}
                        <h2 class="h5 mt-4">Conductor asignado</h2>
                        <ul class="list-unstyled">
                            <li><strong>Nombre:</strong> {{ asignacion.chofer.nombreCompleto }}</li>
                            <li><strong>Contacto:</strong> {{ asignacion.chofer.telefono }}</li>
                            <li><strong>Vehículo:</strong> {{ asignacion.chofer.modeloVehiculo }} ({{ asignacion.chofer.patente }})</li>
                            <li><strong>Tipo:</strong> {{ asignacion.chofer.tipoVehiculo }}</li>
                            {% set featureNames = [] %}
                            {% for feature in asignacion.chofer.vehicleFeatures %}
                                {% set featureNames = featureNames|merge([feature.nombre]) %}
                            {% endfor %}
                            {% if featureNames %}
                                <li><strong>Características:</strong> {{ featureNames|join(', ') }}</li>
                            {% endif %}
                        </ul>
                    {% endif %}
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Realizar pago</h2>
                    {% if opcionesPago is empty %}
                        <p class="text-muted mb-0">Por el momento no hay métodos disponibles. Contactanos para coordinar tu pago.</p>
                    {% else %}
                        <p class="text-muted">Seleccioná tu método de pago preferido.</p>
                        {% for opcion in opcionesPago %}
                            {% if opcion.available is defined and opcion.available == false %}
                                <div class="alert alert-info small" role="alert">
                                    <div class="fw-semibold">{{ opcion.label }}</div>
                                    <div>{{ opcion.reason }}</div>
                                </div>
                            {% else %}
                                {% set btnClass = opcion.type == 'mercadopago' ? 'btn btn-primary w-100 mb-2' : (opcion.type == 'paypal' ? 'btn btn-outline-primary w-100 mb-2' : 'btn btn-outline-secondary w-100 mb-2') %}
                                <a class="{{ btnClass }}" href="{{ opcion.url }}">
                                    {% if opcion.type == 'mercadopago' %}Pagar con Mercado Pago{% elseif opcion.type == 'paypal' %}Pagar con PayPal{% elseif opcion.type == 'cash' %}Solicitar pago en efectivo{% else %}Continuar{% endif %}
                                </a>
                            {% endif %}
                        {% endfor %}
                    {% endif %}
                </div>
            </div>
            {% if pagoEfectivo %}
                <div class="card shadow-sm mb-4 border-warning">
                    <div class="card-body">
                        <h2 class="h6 text-warning">Pago en efectivo pendiente</h2>
                        <p class="mb-1">Total acordado: <strong>{{ pagoEfectivo.amount|number_format(2, ',', '.') }} {{ pagoEfectivo.currency }}</strong></p>
                        {% if pagoEfectivo.notes %}
                            <p class="mb-0">{{ pagoEfectivo.notes|nl2br }}</p>
                        {% endif %}
                    </div>
                </div>
            {% endif %}
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h6">Código de seguimiento</h2>
                    <p class="mb-1"><strong>{{ solicitud.tokenSeguimiento }}</strong></p>
                    <p class="small text-muted">Compartilo con el chofer para que acceda a los detalles y estados del viaje.</p>
                    <a class="btn btn-link p-0" href="{{ path('app_transfer_tracking', {token: solicitud.tokenSeguimiento}) }}">Ver seguimiento</a>
                    <a class="btn btn-link p-0" href="{{ path('app_transfer_pdf', {token: solicitud.tokenSeguimiento}) }}" target="_blank">Descargar PDF</a>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
