{% extends 'base.html.twig' %}

{% block title %}Solicitar traslado{% endblock %}

{% block body %}
<section class="container py-5">
    <h1 class="mb-4">Planificá tu traslado</h1>
    {% for flashError in app.flashes('error') %}
        <div class="alert alert-danger">{{ flashError }}</div>
    {% endfor %}
    {% for flashSuccess in app.flashes('success') %}
        <div class="alert alert-success">{{ flashSuccess }}</div>
    {% endfor %}
    <div class="row g-4">
        <div class="col-lg-6">
            <form method="post" class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">Datos del pasajero</h2>
                    <div class="mb-3">
                        <label class="form-label">Nombre y apellido</label>
                        <input type="text" class="form-control" name="nombre" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo electrónico</label>
                        <input type="email" class="form-control" name="email" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Teléfono del pasajero</label>
                        <input type="tel" class="form-control" name="telefono" value="{{ app.request.get('telefono') }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cantidad de pasajeros</label>
                        <input type="number" class="form-control" name="cantidad_pax" min="1" step="1" value="{{ app.request.get('cantidad_pax') }}" required>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Número de vuelo</label>
                        <input type="text" class="form-control" name="numero_vuelo" maxlength="50" value="{{ app.request.get('numero_vuelo') }}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Tipo de vehículo</label>
                        <select class="form-select" name="tipo_vehiculo" required>
                            <option value="">Seleccioná el tipo de vehículo</option>
                            {% for tipo in vehicleTypes %}
                                <option value="{{ tipo.id }}"{% if app.request.get('tipo_vehiculo') == tipo.id %} selected{% endif %}>{{ tipo.nombre }}</option>
                            {% endfor %}
                        </select>
                        {% if vehicleTypes is empty %}
                            <small class="text-danger">Consultá con el administrador para habilitar tipos de vehículos.</small>
                        {% endif %}
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Inicio del servicio</label>
                            <input type="datetime-local" class="form-control" name="arribo">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Fin del servicio</label>
                            <input type="datetime-local" class="form-control" name="salida">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Notas para el equipo</label>
                        <textarea class="form-control" name="notas" rows="3"></textarea>
                    </div>
                    <h2 class="h5 mt-4">Tipo de traslado</h2>
                    <div class="form-check mb-2">
                        <input class="form-check-input" type="radio" name="tipo" id="tipo_combo" value="combo" checked>
                        <label class="form-check-label" for="tipo_combo">Usar combo preestablecido</label>
                    </div>
                    <div class="mb-3">
                        <select class="form-select" name="combo_id">
                            {% for combo in combos %}
                                {% set comboPrice = combo.getDisplayPrice(plataforma.monedaDef) %}
                                {% set comboSymbol = comboPrice and comboPrice.currency ? (comboPrice.currency.simbolo ?: comboPrice.currency.codigoIso) : (plataforma.monedaDef ? (plataforma.monedaDef.simbolo ?: plataforma.monedaDef.codigoIso) : '$') %}
                                {% set comboAmount = comboPrice ? comboPrice.amount|number_format(2, '.', '') : '—' %}
                                <option value="{{ combo.id }}">{{ combo.nombre }} - {{ comboSymbol }} {{ comboAmount }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    {% if customEnabled %}
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="tipo" id="tipo_custom" value="custom">
                            <label class="form-check-label" for="tipo_custom">Armar mi recorrido</label>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Destinos disponibles</label>
                            <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                {% for destino in destinos %}
                                    {% set destinoPrice = destino.getDisplayPrice(plataforma.monedaDef) %}
                                    {% set destinoSymbol = destinoPrice and destinoPrice.currency ? (destinoPrice.currency.simbolo ?: destinoPrice.currency.codigoIso) : (plataforma.monedaDef ? (plataforma.monedaDef.simbolo ?: plataforma.monedaDef.codigoIso) : '$') %}
                                    {% set destinoAmount = destinoPrice ? destinoPrice.amount|number_format(2, '.', '') : '—' %}
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="destinos[]" value="{{ destino.id }}" id="destino_{{ destino.id }}">
                                        <label class="form-check-label" for="destino_{{ destino.id }}">{{ destino.nombre }} - {{ destinoSymbol }} {{ destinoAmount }}</label>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% else %}
                        <div class="alert alert-info">
                            Los traslados personalizados se encuentran deshabilitados por el administrador. Podés elegir cualquiera de los combos disponibles.
                        </div>
                    {% endif %}
                    {% if campos %}
                        <h2 class="h5 mt-4">Información adicional</h2>
                        {% for campo in campos %}
                            <div class="mb-3">
                                <label class="form-label">{{ campo.etiqueta }}{% if campo.requerido %} *{% endif %}</label>
                                {% set fieldName = 'campo_' ~ campo.clave %}
                                {% if campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_TEXTAREA') %}
                                    <textarea class="form-control" name="{{ fieldName }}" rows="3" {% if campo.requerido %}required{% endif %}></textarea>
                                {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_EMAIL') %}
                                    <input type="email" class="form-control" name="{{ fieldName }}" {% if campo.requerido %}required{% endif %}>
                                {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_PHONE') %}
                                    <input type="tel" class="form-control" name="{{ fieldName }}" {% if campo.requerido %}required{% endif %}>
                                {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_DATETIME') %}
                                    <input type="datetime-local" class="form-control" name="{{ fieldName }}" {% if campo.requerido %}required{% endif %}>
                                {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_NUMBER') %}
                                    <input type="number" class="form-control" name="{{ fieldName }}" {% if campo.requerido %}required{% endif %}>
                                {% else %}
                                    <input type="text" class="form-control" name="{{ fieldName }}" {% if campo.requerido %}required{% endif %}>
                                {% endif %}
                            </div>
                        {% endfor %}
                    {% endif %}
                    <button class="btn btn-success w-100" type="submit">Enviar solicitud</button>
                </div>
            </form>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Combos disponibles</h2>
                    <div class="row g-3">
                        {% for combo in combos %}
                            <div class="col-12">
                                <div class="card h-100 border-0 shadow-sm">
                                    {% if combo.imagenPortada %}
                                        <img src="{{ asset('img/transfer/' ~ combo.imagenPortada) }}" class="card-img-top" alt="{{ combo.nombre }}">
                                    {% endif %}
                                    <div class="card-body">
                                        <h3 class="h6">{{ combo.nombre }}</h3>
                                        {% set comboPrice = combo.getDisplayPrice(plataforma.monedaDef) %}
                                        {% if comboPrice %}
                                            {% set comboSymbol = comboPrice.currency ? (comboPrice.currency.simbolo ?: comboPrice.currency.codigoIso) : (plataforma.monedaDef ? (plataforma.monedaDef.simbolo ?: plataforma.monedaDef.codigoIso) : '$') %}
                                            <div class="text-success fw-semibold mb-2">{{ comboSymbol }} {{ comboPrice.amount|number_format(2, '.', '') }}</div>
                                        {% else %}
                                            <div class="text-muted small mb-2">Tarifa no disponible</div>
                                        {% endif %}
                                        {% if combo.descripcion %}
                                            <p class="small text-muted mb-2">{{ combo.descripcion|striptags|u.truncate(160, '…') }}</p>
                                        {% endif %}
                                        {% if combo.destinos|length > 0 %}
                                            <div class="small text-muted">
                                                <strong>Recorrido:</strong>
                                                {% for enlace in combo.destinos %}
                                                    <span class="badge bg-light text-dark border">{{ enlace.destino.nombre }}</span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12 text-muted">No hay combos disponibles actualmente.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Destinos destacados</h2>
                    <div class="row g-3">
                        {% for destino in destinos %}
                            <div class="col-12">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="row g-0 align-items-center">
                                        {% if destino.imagenPrincipal %}
                                            <div class="col-md-4">
                                                <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal) }}" class="img-fluid rounded-start" alt="{{ destino.nombre }}">
                                            </div>
                                        {% endif %}
                                        <div class="col">
                                            <div class="card-body">
                                                <h3 class="h6 mb-1">{{ destino.nombre }}</h3>
                                                {% set destinoPrice = destino.getDisplayPrice(plataforma.monedaDef ?? null) %}
                                                {% if destinoPrice %}
                                                    {% set destinoSymbol = destinoPrice.currency ? (destinoPrice.currency.simbolo ?: destinoPrice.currency.codigoIso) : (plataforma.monedaDef ? (plataforma.monedaDef.simbolo ?: plataforma.monedaDef.codigoIso) : '$') %}
                                                    <div class="text-success fw-semibold mb-1">Tarifa base: {{ destinoSymbol }} {{ destinoPrice.amount|number_format(2, '.', '') }}</div>
                                                {% else %}
                                                    <div class="text-muted small mb-1">Tarifa no disponible</div>
                                                {% endif %}
                                                {% if destino.descripcionCorta %}
                                                    <p class="small text-muted mb-0">{{ destino.descripcionCorta }}</p>
                                                {% elseif destino.descripcion %}
                                                    <p class="small text-muted mb-0">{{ destino.descripcion|striptags|u.truncate(140, '…') }}</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12 text-muted">Los destinos personalizados aparecerán aquí cuando estén habilitados.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">¿Cómo funciona?</h2>
                    <ol class="small">
                        <li>Completá los datos y elegí un combo o tus destinos personalizados.</li>
                        <li>Confirmá la solicitud y realizá el pago desde el resumen.</li>
                        <li>Recibí en tu correo el código de seguimiento para compartir con el chofer.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
