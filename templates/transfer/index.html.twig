{% extends 'base.html.twig' %}

{% block title %}Solicitar traslado{% endblock %}

{% block body %}
<section class="container py-5">
    <h1 class="mb-4">Planificá tu traslado</h1>
    {% for flashError in app.flashes('error') %}
        <div class="alert alert-danger">{{ flashError }}</div>
    {% endfor %}
    {% for flashSuccess in app.flashes('success') %}
        <div class="alert alert-success">{{ flashSuccess }}</div>
    {% endfor %}
    <div class="row g-4">
        <div class="col-lg-7">
            <form method="post" class="card shadow-sm" data-transfer-form>
                <div class="card-body">
                    <div class="mb-4">
                        <ul class="nav nav-pills flex-column flex-md-row justify-content-between gap-2" data-step-indicator>
                            <li class="nav-item flex-fill text-center">
                                <span class="nav-link active" data-step-label="0">
                                    <span class="fw-semibold d-block">Paso 1</span>
                                    <small class="text-muted">Datos del pasajero</small>
                                </span>
                            </li>
                            <li class="nav-item flex-fill text-center">
                                <span class="nav-link" data-step-label="1">
                                    <span class="fw-semibold d-block">Paso 2</span>
                                    <small class="text-muted">Vehículo y horarios</small>
                                </span>
                            </li>
                            <li class="nav-item flex-fill text-center">
                                <span class="nav-link" data-step-label="2">
                                    <span class="fw-semibold d-block">Paso 3</span>
                                    <small class="text-muted">Traslado y resumen</small>
                                </span>
                            </li>
                        </ul>
                    </div>

                    <div data-step="0">
                        <h2 class="h5">Datos del pasajero</h2>
                        <p class="small text-muted">Completá los datos de contacto del titular del traslado para que podamos confirmar tu reserva.</p>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_nombre">Nombre y apellido</label>
                            <input type="text" class="form-control" id="transfer_nombre" name="nombre" value="{{ app.request.get('nombre') }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_email">Correo electrónico</label>
                            <input type="email" class="form-control" id="transfer_email" name="email" value="{{ app.request.get('email') }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_telefono">Teléfono del pasajero</label>
                            <input type="tel" class="form-control" id="transfer_telefono" name="telefono" value="{{ app.request.get('telefono') }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_cantidad_pax">Cantidad de pasajeros</label>
                            <input type="number" class="form-control" id="transfer_cantidad_pax" name="cantidad_pax" min="1" step="1" value="{{ app.request.get('cantidad_pax') }}" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_numero_vuelo">Número de vuelo</label>
                            <input type="text" class="form-control" id="transfer_numero_vuelo" name="numero_vuelo" maxlength="50" value="{{ app.request.get('numero_vuelo') }}">
                        </div>
                    </div>

                    <div data-step="1" class="d-none">
                        <h2 class="h5">Vehículo y horarios</h2>
                        <p class="small text-muted">Elegí el tipo de vehículo que necesitás y contanos cuándo debemos pasar a buscarte.</p>
                        <input type="hidden" name="tipo_vehiculo" value="{{ app.request.get('tipo_vehiculo') }}" data-vehicle-input required>
                        <div class="row g-3" data-vehicle-grid>
                            {% for tipo in vehicleTypes %}
                                {% set drivers = vehicleDrivers[tipo.id] ?? [] %}
                                <div class="col-12">
                                    <div class="card h-100 border border-2 border-light-subtle vehicle-option" data-vehicle-option data-vehicle-id="{{ tipo.id }}" role="button" tabindex="0">
                                        <div class="card-body">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <div>
                                                    <h3 class="h6 mb-1">{{ tipo.nombre }}</h3>
                                                    {% if tipo.descripcion %}
                                                        <p class="small text-muted mb-0">{{ tipo.descripcion }}</p>
                                                    {% endif %}
                                                </div>
                                                <span class="badge bg-primary-subtle text-primary-emphasis">{{ drivers|length }} chofer{% if drivers|length != 1 %}es{% endif %}</span>
                                            </div>
                                            <div class="mt-3">
                                                {% if drivers %}
                                                    <p class="small text-muted mb-2">Choferes habilitados:</p>
                                                    <div class="row g-2">
                                                        {% for driver in drivers %}
                                                            <div class="col-12">
                                                                <div class="border rounded p-2 bg-body-tertiary">
                                                                    <div class="fw-semibold">{{ driver.nombreCompleto }}</div>
                                                                    <div class="small text-muted">Vehículo: {{ driver.modeloVehiculo }} ({{ driver.patente }})</div>
                                                                    {% set featureNames = [] %}
                                                                    {% for feature in driver.vehicleFeatures %}
                                                                        {% set featureNames = featureNames|merge([feature.nombre]) %}
                                                                    {% endfor %}
                                                                    {% if featureNames %}
                                                                        <div class="mt-2">
                                                                            {% for featureName in featureNames %}
                                                                                <span class="badge bg-secondary-subtle text-secondary-emphasis me-1 mb-1">{{ featureName }}</span>
                                                                            {% endfor %}
                                                                        </div>
                                                                    {% endif %}
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <p class="small text-muted mb-0">Todavía no hay choferes publicados para este tipo de vehículo.</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% else %}
                                <div class="col-12">
                                    <div class="alert alert-warning mb-0">Consultá con el administrador para habilitar tipos de vehículos.</div>
                                </div>
                            {% endfor %}
                        </div>
                        <div class="alert alert-danger mt-3 d-none" data-vehicle-error>Seleccioná un tipo de vehículo para continuar.</div>
                        <div class="row mt-4">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="transfer_arribo">Inicio del servicio</label>
                                <input type="datetime-local" class="form-control" id="transfer_arribo" name="arribo" value="{{ app.request.get('arribo') }}">
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" for="transfer_salida">Fin del servicio</label>
                                <input type="datetime-local" class="form-control" id="transfer_salida" name="salida" value="{{ app.request.get('salida') }}">
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label" for="transfer_notas">Notas para el equipo</label>
                            <textarea class="form-control" id="transfer_notas" name="notas" rows="3">{{ app.request.get('notas') }}</textarea>
                        </div>
                    </div>

                    <div data-step="2" class="d-none">
                        {% set tipoSeleccionado = app.request.get('tipo') ?: 'combo' %}
                        <h2 class="h5">Tipo de traslado</h2>
                        <p class="small text-muted">Seleccioná si querés usar un combo preestablecido o armar tu propio recorrido.</p>
                        <div class="form-check mb-2">
                            <input class="form-check-input" type="radio" name="tipo" id="tipo_combo" value="combo" {% if tipoSeleccionado != 'custom' %}checked{% endif %}>
                            <label class="form-check-label" for="tipo_combo">Usar combo preestablecido</label>
                        </div>
                        <div class="ps-3 mb-3{% if tipoSeleccionado == 'custom' %} d-none{% endif %}" data-transfer-option="combo">
                            <label class="form-label" for="transfer_combo_id">Seleccioná tu combo</label>
                            <select class="form-select" name="combo_id" id="transfer_combo_id" data-combo-select>
                                {% for combo in combos %}
                                    {% set comboPrices = combo.getPreciosDisponibles() %}
                                    {% set comboSummary = [] %}
                                    {% for iso, amount in comboPrices %}
                                        {% set comboSummary = comboSummary|merge([iso ~ ' ' ~ amount|number_format(2, '.', '')]) %}
                                    {% endfor %}
                                    <option value="{{ combo.id }}" data-prices="{{ comboPrices|json_encode|e('html_attr') }}"{% if app.request.get('combo_id') == combo.id %} selected{% endif %}>{{ combo.nombre }}{% if comboSummary %} · {{ comboSummary|join(' · ') }}{% endif %}</option>
                                {% endfor %}
                            </select>
                            <div class="alert alert-info mt-3 d-none" data-combo-summary></div>
                        </div>
                        {% if customEnabled %}
                            {% set destinosSeleccionados = app.request.get('destinos', []) %}
                            {% if destinosSeleccionados is not iterable %}
                                {% set destinosSeleccionados = destinosSeleccionados ? [destinosSeleccionados] : [] %}
                            {% endif %}
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="tipo" id="tipo_custom" value="custom" {% if tipoSeleccionado == 'custom' %}checked{% endif %}>
                                <label class="form-check-label" for="tipo_custom">Armar mi recorrido</label>
                            </div>
                            <div class="ps-3{% if tipoSeleccionado != 'custom' %} d-none{% endif %}" data-transfer-option="custom">
                                <label class="form-label">Destinos disponibles</label>
                                <div class="border rounded p-2" style="max-height: 220px; overflow-y: auto;">
                                    {% for destino in destinos %}
                                        {% set destinoPrices = destino.getPreciosDisponibles() %}
                                        {% set destinoSummary = [] %}
                                        {% for iso, amount in destinoPrices %}
                                            {% set destinoSummary = destinoSummary|merge([iso ~ ' ' ~ amount|number_format(2, '.', '')]) %}
                                        {% endfor %}
                                        <div class="form-check">
                                            <input class="form-check-input" type="checkbox" name="destinos[]" value="{{ destino.id }}" id="destino_{{ destino.id }}" data-destino data-prices="{{ destinoPrices|json_encode|e('html_attr') }}"{% if destino.id in destinosSeleccionados %} checked{% endif %}>
                                            <label class="form-check-label" for="destino_{{ destino.id }}">{{ destino.nombre }}{% if destinoSummary %} – {{ destinoSummary|join(' · ') }}{% endif %}</label>
                                        </div>
                                    {% endfor %}
                                </div>
                                <div class="alert alert-danger mt-3 d-none" data-custom-error>Seleccioná al menos un destino para continuar.</div>
                                <div class="alert alert-info mt-3 d-none" data-custom-summary></div>
                            </div>
                        {% else %}
                            <div class="alert alert-info">Los traslados personalizados se encuentran deshabilitados por el administrador. Podés elegir cualquiera de los combos disponibles.</div>
                        {% endif %}
                        {% if campos %}
                            <h3 class="h6 mt-4">Información adicional</h3>
                            {% for campo in campos %}
                                <div class="mb-3">
                                    <label class="form-label" for="campo_{{ campo.clave }}">{{ campo.etiqueta }}{% if campo.requerido %} *{% endif %}</label>
                                    {% set fieldName = 'campo_' ~ campo.clave %}
                                    {% set requiredAttr = campo.requerido ? 'required' : '' %}
                                    {% if campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_TEXTAREA') %}
                                        <textarea class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" rows="3" {{ requiredAttr }}>{{ app.request.get(fieldName) }}</textarea>
                                    {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_EMAIL') %}
                                        <input type="email" class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" value="{{ app.request.get(fieldName) }}" {{ requiredAttr }}>
                                    {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_PHONE') %}
                                        <input type="tel" class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" value="{{ app.request.get(fieldName) }}" {{ requiredAttr }}>
                                    {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_DATETIME') %}
                                        <input type="datetime-local" class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" value="{{ app.request.get(fieldName) }}" {{ requiredAttr }}>
                                    {% elseif campo.tipo == constant('App\\Entity\\TransferFormField::TYPE_NUMBER') %}
                                        <input type="number" class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" value="{{ app.request.get(fieldName) }}" {{ requiredAttr }}>
                                    {% else %}
                                        <input type="text" class="form-control" id="campo_{{ campo.clave }}" name="{{ fieldName }}" value="{{ app.request.get(fieldName) }}" {{ requiredAttr }}>
                                    {% endif %}
                                </div>
                            {% endfor %}
                        {% endif %}
                        <div class="alert alert-info d-none" data-total-display></div>
                        <div class="alert alert-warning d-none mt-3" data-cash-warning></div>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mt-4">
                        <button class="btn btn-outline-secondary" type="button" data-action="prev">Anterior</button>
                        <div class="d-flex gap-2">
                            <button class="btn btn-primary" type="button" data-action="next">Siguiente</button>
                            <button class="btn btn-success d-none" type="submit" data-submit>Enviar solicitud</button>
                        </div>
                    </div>
                </div>
            </form>
        </div>
        <div class="col-lg-5">
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Combos disponibles</h2>
                    <div class="row g-3">
                        {% for combo in combos %}
                            <div class="col-12">
                                <div class="card h-100 border-0 shadow-sm">
                                    {% if combo.imagenPortada %}
                                        <img src="{{ asset('img/transfer/' ~ combo.imagenPortada) }}" class="card-img-top" alt="{{ combo.nombre }}">
                                    {% endif %}
                                    <div class="card-body">
                                        <h3 class="h6">{{ combo.nombre }}</h3>
                                        {% set comboPrices = combo.getPreciosDisponibles() %}
                                        {% if comboPrices %}
                                            <div class="d-flex flex-wrap gap-2 mb-2">
                                                {% for iso, amount in comboPrices %}
                                                    <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">{{ iso }} {{ amount|number_format(2, '.', '') }}</span>
                                                {% endfor %}
                                            </div>
                                        {% else %}
                                            <div class="text-muted small mb-2">Tarifa no disponible</div>
                                        {% endif %}
                                        {% if combo.descripcion %}
                                            <p class="small text-muted mb-2">{{ combo.descripcion|striptags|u.truncate(160, '…') }}</p>
                                        {% endif %}
                                        {% if combo.destinos|length > 0 %}
                                            <div class="small text-muted">
                                                <strong>Recorrido:</strong>
                                                {% for enlace in combo.destinos %}
                                                    <span class="badge bg-light text-dark border">{{ enlace.destino.nombre }}</span>
                                                {% endfor %}
                                            </div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12 text-muted">No hay combos disponibles actualmente.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-body">
                    <h2 class="h5">Destinos destacados</h2>
                    <div class="row g-3">
                        {% for destino in destinos %}
                            <div class="col-12">
                                <div class="card h-100 border-0 bg-light">
                                    <div class="row g-0 align-items-center">
                                        {% if destino.imagenPrincipal %}
                                            <div class="col-md-4">
                                                <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal) }}" class="img-fluid rounded-start" alt="{{ destino.nombre }}">
                                            </div>
                                        {% endif %}
                                        <div class="col">
                                            <div class="card-body">
                                                <h3 class="h6 mb-1">{{ destino.nombre }}</h3>
                                                {% set destinoPrices = destino.getPreciosDisponibles() %}
                                                {% if destinoPrices %}
                                                    <div class="d-flex flex-wrap gap-2 mb-2">
                                                        {% for iso, amount in destinoPrices %}
                                                            <span class="badge bg-success-subtle text-success-emphasis border border-success-subtle">{{ iso }} {{ amount|number_format(2, '.', '') }}</span>
                                                        {% endfor %}
                                                    </div>
                                                {% else %}
                                                    <div class="text-muted small mb-2">Tarifa no disponible</div>
                                                {% endif %}
                                                {% if destino.descripcionCorta %}
                                                    <p class="small text-muted mb-0">{{ destino.descripcionCorta }}</p>
                                                {% elseif destino.descripcion %}
                                                    <p class="small text-muted mb-0">{{ destino.descripcion|striptags|u.truncate(140, '…') }}</p>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        {% else %}
                            <div class="col-12 text-muted">Los destinos personalizados aparecerán aquí cuando estén habilitados.</div>
                        {% endfor %}
                    </div>
                </div>
            </div>
            <div class="card shadow-sm">
                <div class="card-body">
                    <h2 class="h5">¿Cómo funciona?</h2>
                    <ol class="small mb-0">
                        <li>Completá los datos y elegí un combo o tus destinos personalizados.</li>
                        <li>Confirmá la solicitud y visualizá los montos por moneda antes de pagar.</li>
                        <li>Recibí en tu correo el código de seguimiento para compartir con el chofer.</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
