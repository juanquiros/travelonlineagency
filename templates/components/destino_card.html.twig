<div class="destino-card card h-100 shadow-sm border-0 overflow-hidden">
    {% if destino.imagenPrincipal %}
        <div class="ratio ratio-4x3">
            <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal)|imagine_filter('destino_card') }}" class="card-img-top object-fit-cover" alt="{{ destino.nombre }}">
        </div>
    {% else %}
        <div class="ratio ratio-4x3 bg-light d-flex align-items-center justify-content-center text-muted">
            <span class="bi bi-image"></span>
        </div>
    {% endif %}
    <div class="card-body d-flex flex-column gap-3">
        {% set categoryColor = destino.categoria and destino.categoria.color ? destino.categoria.color : '#1F6BB3' %}
        <div class="d-flex justify-content-between align-items-start">
            <h3 class="h5 mb-0">{{ destino.nombre }}</h3>
            <span class="badge destino-category-badge"
                  style="--destino-category-color: {{ categoryColor }};">
                {% if destino.categoria %}
                    {% if destino.categoria.icono %}{{ destino.categoria.icono|raw }} {% endif %}{{ destino.categoria.nombre }}
                {% else %}
                    Destino
                {% endif %}
            </span>
        </div>
        <p class="text-muted small mb-0">{{ destino.descripcionCorta ?: 'Próximamente más detalles sobre este destino.' }}</p>
        <div class="d-flex gap-2 align-items-center text-muted small">
            <span class="bi bi-geo-alt"></span>
            <span>{{ destino.direccion ?: 'Misiones, Argentina' }}</span>
        </div>
        {% set redes = [
            { 'url': destino.sitioWeb, 'icon': 'bi-globe', 'label': 'Sitio web' },
            { 'url': destino.instagram, 'icon': 'bi-instagram', 'label': 'Instagram' },
            { 'url': destino.x, 'icon': 'bi-twitter-x bi-twitter', 'label': 'X' },
            { 'url': destino.facebook, 'icon': 'bi-facebook', 'label': 'Facebook' },
            { 'url': destino.whatsapp, 'icon': 'bi-whatsapp', 'label': 'WhatsApp' }
        ] %}
        {% set redes_activas = [] %}
        {% for red in redes %}
            {% if red.url is not empty %}
                {% set redes_activas = redes_activas|merge([red]) %}
            {% endif %}
        {% endfor %}
        {% if redes_activas is not empty %}
            <div class="d-flex flex-wrap gap-2 align-items-center small destino-card-social">
                {% for red in redes_activas %}
                    <a class="btn btn-sm btn-outline-secondary d-inline-flex align-items-center gap-1" href="{{ red.url }}" target="_blank" rel="noopener">
                        <span class="bi {{ red.icon }}"></span>
                        <span>{{ red.label }}</span>
                    </a>
                {% endfor %}
            </div>
        {% endif %}
        <div class="mt-auto d-flex align-items-center justify-content-between">
            <span class="destino-icono text-primary">
                {% if destino.categoria and destino.categoria.icono %}
                    {{ destino.categoria.icono|raw }}
                {% else %}
                    <span class="bi bi-pin-map"></span>
                {% endif %}
            </span>
            <a class="btn btn-outline-primary" href="{{ path('app_destino_show', { id: destino.id }) }}">
                Ver más
            </a>
        </div>
    </div>
</div>
