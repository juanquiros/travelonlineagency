{# Pre-build a lightweight destinos payload so the Stimulus controller can render markers even if the API request fails. #}
{% set destinos_collection = destinosData is defined and destinosData is not empty ? destinosData : [] %}
{% set destinos_payload = [] %}
{% for destino in destinos_collection %}
    {% if destino.activo %}
        {% set categoria = destino.categoria %}
        {% set destinos_payload = destinos_payload|merge([
            {
                id: destino.id,
                nombre: destino.nombre,
                direccion: destino.direccion,
                lat: destino.coordenadasLat,
                lng: destino.coordenadasLng,
                descripcionCorta: destino.descripcionCorta,
                descripcionDetallada: destino.descripcionDetallada,
                imagen: destino.imagenPrincipal ? asset('img/destinos/' ~ destino.imagenPrincipal) : null,
                categoria: categoria ? {
                    id: categoria.id,
                    nombre: categoria.nombre,
                    icono: categoria.icono,
                    color: categoria.color,
                } : null,
                instagram: destino.instagram,
                x: destino.x,
                facebook: destino.facebook,
                whatsapp: destino.whatsapp,
                sitioWeb: destino.sitioWeb,
                redes: {
                    instagram: destino.instagram,
                    x: destino.x,
                    facebook: destino.facebook,
                    whatsapp: destino.whatsapp,
                    sitioWeb: destino.sitioWeb
                }
            }
        ]) %}
    {% endif %}
{% endfor %}
{% set json_flags = constant('JSON_UNESCAPED_UNICODE')
    b-or constant('JSON_HEX_TAG')
    b-or constant('JSON_HEX_APOS')
    b-or constant('JSON_HEX_QUOT')
    b-or constant('JSON_HEX_AMP') %}
{% set destinos_json = destinos_payload is not empty ? destinos_payload|json_encode(json_flags) : null %}
<div class="card toa-map-card mx-auto">
    <div class="card-body destinos-map-wrapper"
         data-controller="destinos-map"
         data-destinos-map-src-value="{{ apiUrl }}"
         data-destinos-map-default-lat-value="-25.6000"
         data-destinos-map-default-lng-value="-54.5667"
         {% if destinos_json %}
             data-destinos-map-destinos-value="{{ destinos_json|e('html_attr') }}"
         {% endif %}>
        <div class="d-flex justify-content-between flex-wrap align-items-center gap-3 mb-3">
            <div>
                <h3 class="h6 text-uppercase text-muted mb-1">Explorá Iguazú</h3>
                <p class="small text-muted mb-0">Mové el mapa, descubrí categorías y abrí cada marcador para ver más detalles.</p>
            </div>
            <div class="destinos-map-filter d-none" data-destinos-map-target="filterContainer">
                <span class="form-label text-uppercase small text-muted mb-2 d-block">Filtrar por categoría</span>
                <div class="destinos-map-filter-list" data-destinos-map-target="filterList"></div>
            </div>
        </div>
        <div class="ratio ratio-16x9 position-relative destinos-map-frame">
            <div data-destinos-map-target="map" class="w-100 h-100 rounded"></div>
            {% if destinos_json %}
                <script type="application/json" data-destinos-map-target="dataset">{{ destinos_json|raw }}</script>
            {% endif %}
        </div>
        <div class="alert alert-warning mt-3 d-none" data-destinos-map-target="fallback">
            No pudimos cargar el mapa en este momento. Volvé a intentarlo más tarde.
        </div>
    </div>
</div>
