{% extends 'administrador/base.html.twig' %}

{% block title %}Monedas y medios de pago{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ editing ? 'Editar moneda' : 'Nueva moneda' }}</h2>
                <p class="text-muted small">Asigná un código ISO válido y asociá la moneda al medio de pago correspondiente. Solo se permite una moneda por medio de pago digital; el efectivo admite múltiples alternativas.</p>
                {{ form_start(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.codigoIso) }}
                {{ form_row(form.simbolo) }}
                {{ form_row(form.metodoPago) }}
                {{ form_row(form.habilitada) }}
                <button class="btn btn-primary w-100" type="submit">{{ editing ? 'Guardar cambios' : 'Crear moneda' }}</button>
                {{ form_end(form) }}
                {% if editing and editingCurrency is defined %}
                    <a class="btn btn-link mt-2" href="{{ path('app_admin_currencies') }}">Crear una nueva moneda</a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between mb-3 gap-3">
                    <div>
                        <h2 class="h5 mb-1">Monedas configuradas</h2>
                        <p class="text-muted small mb-0">Gestioná las monedas disponibles para los traslados, reservas y medios de pago.</p>
                    </div>
                </div>
                <table class="table table-striped align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Código</th>
                            <th>Medio de pago</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for currency in monedas %}
                        <tr>
                            <td>
                                <div class="fw-semibold">{{ currency.nombre }}</div>
                                <div class="small text-muted">Símbolo: {{ currency.simbolo ?: 'N/D' }}</div>
                            </td>
                            <td>{{ currency.codigoIso ?: '—' }}</td>
                            <td>
                                {% if currency.metodoPago == constant('App\\Entity\\Moneda::METODO_MERCADOPAGO') %}
                                    <span class="badge text-bg-info">Mercado Pago</span>
                                {% elseif currency.metodoPago == constant('App\\Entity\\Moneda::METODO_PAYPAL') %}
                                    <span class="badge text-bg-primary">PayPal</span>
                                {% else %}
                                    <span class="badge text-bg-secondary">Pago en efectivo</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if currency.habilitada %}
                                    <span class="badge bg-success">Habilitada</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactiva</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <div class="btn-group" role="group">
                                    <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_currency_edit', { id: currency.id }) }}">Editar</a>
                                    <form method="post" action="{{ path('app_admin_currency_toggle', { id: currency.id }) }}">
                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle_currency_' ~ currency.id) }}">
                                        <button class="btn btn-sm btn-outline-secondary" type="submit">{{ currency.habilitada ? 'Deshabilitar' : 'Habilitar' }}</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="5" class="text-center text-muted py-4">Aún no configuraste monedas. Creá una para empezar.</td>
                        </tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
