{% extends 'administrador/base.html.twig' %}

{% block title %}Chofer: {{ driver.nombreCompleto }}{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-4">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <div class="d-flex justify-content-between align-items-start mb-3">
                    <h2 class="h5 mb-0">Información del chofer</h2>
                    <a class="btn btn-outline-primary btn-sm" href="{{ path('app_admin_driver_balance_pdf', {id: driver.id}) }}" target="_blank" rel="noopener">Descargar balance PDF</a>
                </div>
                <dl class="row small mb-0">
                    <dt class="col-5">Nombre</dt>
                    <dd class="col-7">{{ driver.nombreCompleto }}</dd>
                    <dt class="col-5">Documento</dt>
                    <dd class="col-7">{{ driver.documento }}</dd>
                    <dt class="col-5">Teléfono</dt>
                    <dd class="col-7">{{ driver.telefono }}</dd>
                    <dt class="col-5">Correo</dt>
                    <dd class="col-7">{{ driver.usuario.email }}</dd>
                    <dt class="col-5">Vehículo</dt>
                    <dd class="col-7">{{ driver.modeloVehiculo }} ({{ driver.patente }})</dd>
                    <dt class="col-5">Estado</dt>
                    <dd class="col-7">
                        {% if driver.aprobado %}
                            <span class="badge bg-success">Habilitado</span>
                        {% else %}
                            <span class="badge bg-warning text-dark">Pendiente</span>
                        {% endif %}
                    </dd>
                    <dt class="col-5">CBU</dt>
                    <dd class="col-7">{{ driver.cbu ?: 'No informado' }}</dd>
                    <dt class="col-5">CVU</dt>
                    <dd class="col-7">{{ driver.cvu ?: 'No informado' }}</dd>
                    <dt class="col-5">Alias</dt>
                    <dd class="col-7">{{ driver.bankAlias ?: 'No informado' }}</dd>
                </dl>
                {% if driver.fotoVehiculo %}
                    <img src="{{ asset('img/drivers/' ~ driver.fotoVehiculo) }}" alt="Vehículo" class="img-fluid rounded mt-3">
                {% endif %}
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 text-uppercase text-muted mb-3">Resumen financiero</h2>
                {% set currency = entries|length > 0 ? entries[0].currency : 'ARS' %}
                <dl class="row small mb-0">
                    <dt class="col-7">Total créditos</dt>
                    <dd class="col-5 text-end fw-semibold">{{ currency }} {{ stats.credits|number_format(2, ',', '.') }}</dd>
                    <dt class="col-7">Total débitos</dt>
                    <dd class="col-5 text-end">{{ currency }} {{ stats.debits|number_format(2, ',', '.') }}</dd>
                    <dt class="col-7">Saldo neto</dt>
                    <dd class="col-5 text-end fw-semibold">{{ currency }} {{ stats.balance|number_format(2, ',', '.') }}</dd>
                    <dt class="col-7">Retiros pendientes</dt>
                    <dd class="col-5 text-end">{{ currency }} {{ stats.pending|number_format(2, ',', '.') }}</dd>
                    <dt class="col-7">Saldo disponible</dt>
                    <dd class="col-5 text-end text-success fw-semibold">{{ currency }} {{ stats.available|number_format(2, ',', '.') }}</dd>
                </dl>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h6 mb-3">Comisión de plataforma</h2>
                <form method="post" action="{{ path('app_admin_driver_commission', {id: driver.id}) }}" class="d-flex gap-2 align-items-end">
                    <input type="hidden" name="_token" value="{{ csrf_token('driver_commission_' ~ driver.id) }}">
                    <div class="flex-grow-1">
                        <label class="form-label small">Porcentaje (%)</label>
                        <input type="number" name="commission" min="0" max="100" step="0.5" class="form-control form-control-sm" value="{{ driver.commissionPercentage }}">
                    </div>
                    <button class="btn btn-primary btn-sm" type="submit">Actualizar</button>
                </form>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h6 mb-3">Agregar movimiento manual</h2>
                <form method="post" action="{{ path('app_admin_driver_balance_entry', {id: driver.id}) }}" class="row g-2">
                    <input type="hidden" name="_token" value="{{ csrf_token('driver_balance_entry_' ~ driver.id) }}">
                    <div class="col-6">
                        <label class="form-label small">Monto</label>
                        <input type="number" step="0.01" min="0" name="amount" class="form-control form-control-sm" required>
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Moneda</label>
                        <input type="text" name="currency" class="form-control form-control-sm" value="{{ currency }}" maxlength="3">
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Movimiento</label>
                        <select name="direction" class="form-select form-select-sm">
                            <option value="credit">Crédito</option>
                            <option value="debit">Débito</option>
                        </select>
                    </div>
                    <div class="col-6">
                        <label class="form-label small">Tipo</label>
                        <input type="text" name="type" class="form-control form-control-sm" value="{{ constant('App\\Entity\\DriverBalanceEntry::TYPE_ADJUSTMENT') }}" maxlength="40">
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Descripción</label>
                        <textarea name="description" rows="2" class="form-control form-control-sm"></textarea>
                    </div>
                    <div class="col-12">
                        <label class="form-label small">Referencia</label>
                        <input type="text" name="reference" class="form-control form-control-sm" maxlength="120">
                    </div>
                    <div class="col-12">
                        <button class="btn btn-outline-primary btn-sm w-100" type="submit">Registrar movimiento</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="col-lg-8">
        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h2 class="h5 mb-3">Movimientos recientes</h2>
                <div class="table-responsive">
                    <table class="table table-striped table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Tipo</th>
                                <th>Movimiento</th>
                                <th class="text-end">Monto</th>
                                <th>Descripción</th>
                                <th>Referencia</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for entry in entries %}
                                <tr>
                                    <td>{{ entry.createdAt|date('d/m/Y H:i') }}</td>
                                    <td class="text-uppercase small">{{ entry.type|replace({'_':' '}) }}</td>
                                    <td>
                                        {% if entry.isCredit() %}
                                            <span class="badge bg-success-subtle text-success">Crédito</span>
                                        {% else %}
                                            <span class="badge bg-danger-subtle text-danger">Débito</span>
                                        {% endif %}
                                    </td>
                                    <td class="text-end fw-semibold">{{ entry.currency }} {{ entry.amount|number_format(2, ',', '.') }}</td>
                                    <td class="small">{{ entry.description ?: '—' }}</td>
                                    <td class="small">{{ entry.reference ?: '—' }}</td>
                                </tr>
                            {% else %}
                                <tr><td colspan="6" class="text-center text-muted">Sin movimientos registrados.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Solicitudes de retiro</h2>
                <div class="table-responsive">
                    <table class="table table-sm align-middle">
                        <thead>
                            <tr>
                                <th>Fecha</th>
                                <th>Monto</th>
                                <th>Estado</th>
                                <th>Notas</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for retiro in solicitudes %}
                                <tr>
                                    <td>{{ retiro.createdAt|date('d/m/Y H:i') }}</td>
                                    <td>{{ retiro.currency }} {{ retiro.amount|number_format(2, ',', '.') }}</td>
                                    <td class="text-uppercase small">{{ retiro.status|replace({'_':' '}) }}</td>
                                    <td class="small">{{ retiro.adminNotes ?: retiro.notes ?: '—' }}</td>
                                    <td class="text-end">
                                        <form method="post" action="{{ path('app_admin_driver_withdrawal_update', {driver: driver.id, id: retiro.id}) }}" class="d-flex flex-column gap-2">
                                            <input type="hidden" name="_token" value="{{ csrf_token('driver_withdrawal_' ~ retiro.id) }}">
                                            <select name="status" class="form-select form-select-sm">
                                                <option value="pending" {% if retiro.status == 'pending' %}selected{% endif %}>Pendiente</option>
                                                <option value="approved" {% if retiro.status == 'approved' %}selected{% endif %}>Aprobado</option>
                                                <option value="paid" {% if retiro.status == 'paid' %}selected{% endif %}>Pagado</option>
                                                <option value="rejected" {% if retiro.status == 'rejected' %}selected{% endif %}>Rechazado</option>
                                            </select>
                                            <textarea name="admin_notes" class="form-control form-control-sm" rows="2" placeholder="Notas internas">{{ retiro.adminNotes }}</textarea>
                                            <button class="btn btn-outline-primary btn-sm" type="submit">Actualizar</button>
                                        </form>
                                    </td>
                                </tr>
                            {% else %}
                                <tr><td colspan="5" class="text-center text-muted">Sin solicitudes de retiro registradas.</td></tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
