{% extends 'administrador/base.html.twig' %}

{% block title %}Gestión de choferes{% endblock %}

{% block body %}
<div class="row g-4 mb-4">
    <div class="col-12">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Balance general de choferes</h2>
                <div class="row g-3">
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <p class="text-muted small text-uppercase mb-1">Total acreditado</p>
                            <p class="fs-5 fw-semibold mb-0">{{ driverCurrency }} {{ driverStats.credits|number_format(2, ',', '.') }}</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <p class="text-muted small text-uppercase mb-1">Total debitado</p>
                            <p class="fs-5 fw-semibold mb-0">{{ driverCurrency }} {{ driverStats.debits|number_format(2, ',', '.') }}</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <p class="text-muted small text-uppercase mb-1">Saldo neto</p>
                            <p class="fs-5 fw-semibold mb-0">{{ driverCurrency }} {{ driverStats.balance|number_format(2, ',', '.') }}</p>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="border rounded p-3 h-100 bg-light">
                            <p class="text-muted small text-uppercase mb-1">Retiros pendientes</p>
                            <p class="fs-5 fw-semibold mb-0">{{ driverCurrency }} {{ driverStats.pending|number_format(2, ',', '.') }}</p>
                            <p class="text-muted small mb-0">Saldo disponible: {{ driverCurrency }} {{ driverStats.available|number_format(2, ',', '.') }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Solicitudes pendientes</h2>
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Documento</th>
                            <th>Contacto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for driver in pendientes %}
                        <tr>
                            <td>
                                <button class="btn btn-link p-0 text-start" type="button" data-bs-toggle="collapse" data-bs-target="#driver-pending-{{ driver.id }}" aria-expanded="false" aria-controls="driver-pending-{{ driver.id }}">
                                    {{ driver.nombreCompleto }}
                                </button>
                            </td>
                            <td>{{ driver.documento }}</td>
                            <td>{{ driver.telefono }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('app_admin_driver_state', {id: driver.id}) }}" class="d-inline">
                                    <input type="hidden" name="action" value="approve">
                                    <button class="btn btn-sm btn-success" type="submit">Aprobar</button>
                                </form>
                            </td>
                        </tr>
                        <tr class="collapse" id="driver-pending-{{ driver.id }}">
                            <td colspan="4" class="bg-light">
                                <dl class="row mb-0 small">
                                    <dt class="col-sm-3">Correo</dt>
                                    <dd class="col-sm-9">{{ driver.usuario.email }}</dd>
                                    <dt class="col-sm-3">Tipo de vehículo</dt>
                                    <dd class="col-sm-9">{{ driver.tipoVehiculo }}</dd>
                                    <dt class="col-sm-3">Modelo</dt>
                                    <dd class="col-sm-9">{{ driver.modeloVehiculo }} ({{ driver.patente }})</dd>
                                    <dt class="col-sm-3">CBU</dt>
                                    <dd class="col-sm-9">{{ driver.cbu ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">CVU</dt>
                                    <dd class="col-sm-9">{{ driver.cvu ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">Alias</dt>
                                    <dd class="col-sm-9">{{ driver.bankAlias ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">Notas</dt>
                                    <dd class="col-sm-9">{{ driver.notas ?: '—' }}</dd>
                                    <dt class="col-sm-3">Registrado</dt>
                                    <dd class="col-sm-9">{{ driver.creadoEn|date('d/m/Y H:i') }}</dd>
                                    <dt class="col-sm-3">Acciones</dt>
                                    <dd class="col-sm-9">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_driver_balance', {id: driver.id}) }}">Ver ficha completa</a>
                                    </dd>
                                </dl>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted">No hay choferes pendientes.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Choferes habilitados</h2>
                <table class="table table-striped align-middle">
                    <thead>
                        <tr>
                            <th>Nombre</th>
                            <th>Vehículo</th>
                            <th>Contacto</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for driver in habilitados %}
                        <tr>
                            <td>
                                <button class="btn btn-link p-0 text-start" type="button" data-bs-toggle="collapse" data-bs-target="#driver-enabled-{{ driver.id }}" aria-expanded="false" aria-controls="driver-enabled-{{ driver.id }}">
                                    {{ driver.nombreCompleto }}
                                </button>
                            </td>
                            <td>
                                <div class="fw-semibold">{{ driver.tipoVehiculo }}</div>
                                <div class="small text-muted">{{ driver.modeloVehiculo }} ({{ driver.patente }})</div>
                            </td>
                            <td>{{ driver.telefono }}</td>
                            <td class="text-end">
                                <form method="post" action="{{ path('app_admin_driver_state', {id: driver.id}) }}" class="d-inline">
                                    <input type="hidden" name="action" value="suspend">
                                    <button class="btn btn-sm btn-outline-danger" type="submit">Suspender</button>
                                </form>
                            </td>
                        </tr>
                        <tr class="collapse" id="driver-enabled-{{ driver.id }}">
                            <td colspan="4" class="bg-light">
                                <dl class="row mb-0 small">
                                    <dt class="col-sm-3">Correo</dt>
                                    <dd class="col-sm-9">{{ driver.usuario.email }}</dd>
                                    <dt class="col-sm-3">Tipo de vehículo</dt>
                                    <dd class="col-sm-9">{{ driver.tipoVehiculo }}</dd>
                                    <dt class="col-sm-3">Notas</dt>
                                    <dd class="col-sm-9">{{ driver.notas ?: '—' }}</dd>
                                    <dt class="col-sm-3">CBU</dt>
                                    <dd class="col-sm-9">{{ driver.cbu ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">CVU</dt>
                                    <dd class="col-sm-9">{{ driver.cvu ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">Alias</dt>
                                    <dd class="col-sm-9">{{ driver.bankAlias ?: 'No informado' }}</dd>
                                    <dt class="col-sm-3">Última actualización</dt>
                                    <dd class="col-sm-9">{{ driver.actualizadoEn|date('d/m/Y H:i') }}</dd>
                                    {% if driver.fotoVehiculo %}
                                        <dt class="col-sm-3">Vehículo</dt>
                                        <dd class="col-sm-9">
                                            <img src="{{ asset('img/drivers/' ~ driver.fotoVehiculo) }}" alt="Vehículo" class="img-fluid rounded" style="max-height: 160px;">
                                        </dd>
                                    {% endif %}
                                    <dt class="col-sm-3">Acciones</dt>
                                    <dd class="col-sm-9">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_driver_balance', {id: driver.id}) }}">Ver ficha completa</a>
                                    </dd>
                                </dl>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="4" class="text-center text-muted">Aún no hay choferes aprobados.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
