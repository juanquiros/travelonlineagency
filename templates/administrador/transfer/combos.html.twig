{% extends 'administrador/base.html.twig' %}

{% block title %}Combos de traslado{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ editing ? 'Editar combo' : 'Nuevo combo' }}</h2>
                {% if monedas is defined and monedas is empty %}
                    <div class="alert alert-warning small" role="alert">
                        Configurá al menos una moneda activa antes de publicar nuevos combos de traslado.
                    </div>
                {% endif %}
                {{ form_start(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.descripcion) }}
                <div class="mb-3">
                    <h3 class="h6 text-uppercase text-muted mb-2">Tarifas por moneda</h3>
                    <div class="border rounded p-3 bg-light-subtle">
                        {{ form_row(form.prices) }}
                        <p class="form-text mb-0">Ingresá los montos según la divisa de cada medio de pago.</p>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Imagen de portada</label>
                    {{ form_widget(form.imagenPortadaFile, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.imagenPortadaFile) }}
                    <div class="form-text">Formatos recomendados: JPG o PNG, máximo 2MB.</div>
                    {% if editing and editingCombo is defined and editingCombo.imagenPortada %}
                        <div class="mt-3">
                            <span class="d-block text-muted small">Actual:</span>
                            <img src="{{ asset('img/transfer/' ~ editingCombo.imagenPortada) }}" alt="Portada actual" class="img-fluid rounded border">
                        </div>
                    {% endif %}
                </div>
                {{ form_row(form.destinos) }}
                {{ form_row(form.activo) }}
                <button class="btn btn-primary w-100" type="submit">{{ editing ? 'Guardar cambios' : 'Crear combo' }}</button>
                {{ form_end(form) }}
                {% if editing %}
                    <a class="btn btn-link mt-2" href="{{ path('app_admin_transfer_combos') }}">Crear un nuevo combo</a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5">Listado</h2>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Portada</th>
                            <th>Nombre</th>
                            <th>Tarifas configuradas</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for combo in combos %}
                        <tr>
                            <td class="align-middle" style="width: 80px;">
                                {% if combo.imagenPortada %}
                                    <img src="{{ asset('img/transfer/' ~ combo.imagenPortada) }}" alt="{{ combo.nombre }}" class="img-thumbnail" style="max-width: 72px;">
                                {% else %}
                                    <span class="text-muted small">Sin imagen</span>
                                {% endif %}
                            </td>
                            <td>{{ combo.nombre }}</td>
                            <td>
                                {% set tarifas = combo.preciosDisponibles %}
                                {% if tarifas is not empty %}
                                    <ul class="list-unstyled mb-0 small">
                                        {% for iso, monto in tarifas %}
                                            {% set simbolo = null %}
                                            {% for precio in combo.precios %}
                                                {% set precioIso = precio.moneda ? (precio.moneda.codigoIso ?: precio.moneda.simbolo) : null %}
                                                {% if precioIso and precioIso|upper == iso %}
                                                    {% set simbolo = precio.moneda.simbolo ?: precio.moneda.codigoIso %}
                                                    {% break %}
                                                {% endif %}
                                            {% endfor %}
                                            {% if simbolo is null and combo.moneda and (combo.moneda.codigoIso ?: combo.moneda.simbolo)|upper == iso %}
                                                {% set simbolo = combo.moneda.simbolo ?: combo.moneda.codigoIso %}
                                            {% endif %}
                                            <li>
                                                <span class="fw-semibold">{{ simbolo ?: iso }}</span>
                                                {{ monto|number_format(2, '.', '') }}
                                            </li>
                                        {% endfor %}
                                    </ul>
                                {% else %}
                                    <span class="text-muted small">Sin tarifas</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if combo.activo %}
                                    <span class="badge bg-success">Activo</span>
                                {% else %}
                                    <span class="badge bg-secondary">Oculto</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_transfer_combo_edit', {id: combo.id}) }}">Editar</a>
                                <form method="post" action="{{ path('app_admin_transfer_combo_toggle', {id: combo.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle_combo_' ~ combo.id) }}">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">{{ combo.activo ? 'Ocultar' : 'Mostrar' }}</button>
                                </form>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted">Sin combos configurados.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
