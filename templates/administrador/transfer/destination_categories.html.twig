{% extends 'administrador/base.html.twig' %}

{% block title %}Categorías de destinos{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ editing ? 'Editar categoría' : 'Nueva categoría' }}</h2>
                {{ form_start(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.iconDefinition) }}
                {{ form_row(form.color) }}
                {{ form_row(form.Guardar, {'attr': {'class': 'btn btn-primary w-100'}}) }}
                {{ form_end(form) }}
                {% if editing %}
                    <a class="btn btn-link mt-2" href="{{ path('app_admin_transfer_destination_categories') }}">Crear una nueva categoría</a>
                {% endif %}
                <p class="small text-muted mt-3 mb-0">Administrá los íconos disponibles desde la <a href="{{ path('app_admin_transfer_destination_icons') }}">biblioteca de íconos</a>.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Listado</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                        <tr>
                            <th style="width: 80px;">Ícono</th>
                            <th>Nombre</th>
                            <th>Ícono seleccionado</th>
                            <th style="width: 80px;" class="text-center">Color</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for categoria in categorias %}
                            <tr>
                                <td>
                                    {% if categoria.icono %}
                                        <span class="fs-4">{{ categoria.icono|raw }}</span>
                                    {% else %}
                                        <span class="text-muted small">Sin ícono</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <div class="fw-semibold">{{ categoria.nombre }}</div>
                                    <div class="text-muted small">{{ categoria.destinos|length }} destinos asociados</div>
                                </td>
                                <td>
                                    {% if categoria.iconDefinition %}
                                        <div class="d-flex align-items-center gap-2">
                                            <span class="fs-5">{{ categoria.icono|raw }}</span>
                                            <span class="text-muted small">{{ categoria.iconDefinition.nombre }}</span>
                                        </div>
                                    {% elseif categoria.icono %}
                                        <span class="fs-5">{{ categoria.icono|raw }}</span>
                                        <div class="text-muted small">Icono personalizado</div>
                                    {% else %}
                                        <span class="text-muted small">Sin icono</span>
                                    {% endif %}
                                </td>
                                <td class="text-center">
                                    {% set color = categoria.color ?: '#1F6BB3' %}
                                    <span class="badge rounded-pill text-bg-light border" style="--bs-bg-opacity: 1; background-color: {{ color }}; border-color: rgba(0,0,0,0.1); color: #fff;">&nbsp;</span>
                                    <div class="small text-muted mt-1">{{ categoria.color ?: 'Automático' }}</div>
                                </td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_transfer_destination_category_edit', {id: categoria.id}) }}">Editar</a>
                                        <form method="post" action="{{ path('app_admin_transfer_destination_category_delete', {id: categoria.id}) }}" onsubmit="return confirm('¿Eliminar esta categoría? Esta acción no se puede deshacer.');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_destination_category_' ~ categoria.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" type="submit" {% if categoria.destinos|length > 0 %}disabled{% endif %}>Eliminar</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="3" class="text-center text-muted py-4">Todavía no hay categorías registradas.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
