{% extends 'administrador/base.html.twig' %}

{% block title %}Biblioteca de íconos{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ editing ? 'Editar ícono' : 'Nuevo ícono' }}</h2>
                {{ form_start(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.cssClass) }}
                {{ form_row(form.Guardar, {'attr': {'class': 'btn btn-primary w-100'}}) }}
                {{ form_end(form) }}
                {% if editing %}
                    <a class="btn btn-link mt-2" href="{{ path('app_admin_transfer_destination_icons') }}">Crear un nuevo ícono</a>
                {% endif %}
                <p class="small text-muted mt-3 mb-0">Consultá la galería oficial de <a href="https://icons.getbootstrap.com/" target="_blank" rel="noopener">Bootstrap Icons</a> y copiá el nombre de la clase para añadirlo a la biblioteca.</p>
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">Iconos disponibles</h2>
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead>
                        <tr>
                            <th style="width: 80px;">Vista previa</th>
                            <th>Nombre</th>
                            <th>Clase CSS</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                        </thead>
                        <tbody>
                        {% for icon in icons %}
                            <tr>
                                <td><span class="fs-3">{{ icon.getMarkup()|raw }}</span></td>
                                <td>{{ icon.nombre }}</td>
                                <td><code>{{ icon.cssClass }}</code></td>
                                <td class="text-end">
                                    <div class="btn-group">
                                        <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_transfer_destination_icon_edit', {id: icon.id}) }}">Editar</a>
                                        <form method="post" action="{{ path('app_admin_transfer_destination_icon_delete', {id: icon.id}) }}" onsubmit="return confirm('¿Eliminar este ícono?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_destination_icon_' ~ icon.id) }}">
                                            <button class="btn btn-sm btn-outline-danger" type="submit" {% if icon.categories|length > 0 %}disabled{% endif %}>Eliminar</button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        {% else %}
                            <tr>
                                <td colspan="4" class="text-center text-muted py-4">Todavía no hay íconos cargados.</td>
                            </tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
