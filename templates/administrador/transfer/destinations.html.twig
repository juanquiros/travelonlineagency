{% extends 'administrador/base.html.twig' %}

{% block title %}Destinos de traslado{% endblock %}

{% block body %}
<div class="row g-4">
    <div class="col-lg-5">
        <div class="card shadow-sm">
            <div class="card-body">
                <h2 class="h5 mb-3">{{ editing ? 'Editar destino' : 'Nuevo destino' }}</h2>
                {{ form_start(form) }}
                {{ form_row(form.nombre) }}
                {{ form_row(form.categoria) }}
                {{ form_row(form.direccion) }}
                {{ form_row(form.descripcionCorta) }}
                {{ form_row(form.descripcionDetallada) }}
                {{ form_row(form.tarifaBase) }}
                <div class="mb-3">
                    <label class="form-label">Imagen principal</label>
                    {{ form_widget(form.imagenPortadaFile, {'attr': {'class': 'form-control'}}) }}
                    {{ form_errors(form.imagenPortadaFile) }}
                    <div class="form-text">Se usará en las tarjetas públicas y en el mapa interactivo.</div>
                    {% if editing and editingDestination is defined and editingDestination.imagenPrincipal %}
                        <div class="mt-3">
                            <span class="d-block text-muted small">Actual:</span>
                            <img src="{{ asset('img/destinos/' ~ editingDestination.imagenPrincipal) }}" alt="Portada destino" class="img-fluid rounded border">
                        </div>
                    {% endif %}
                </div>
                {% set hasCoords = editing and editingDestination is defined and editingDestination.latitude is not null and editingDestination.longitude is not null %}
                <div class="mb-3"
                     data-controller="transfer-destination-map"
                     {% if hasCoords %}data-transfer-destination-map-lat-value="{{ editingDestination.latitude }}"{% endif %}
                     {% if hasCoords %}data-transfer-destination-map-lng-value="{{ editingDestination.longitude }}"{% endif %}
                     data-transfer-destination-map-zoom-value="{{ mapDefaults.zoom }}">
                    <label class="form-label">Ubicación en el mapa</label>
                    <div class="border rounded" data-transfer-destination-map-target="map" style="height: 280px;"></div>
                    <div class="small text-muted mt-2" data-transfer-destination-map-target="output">
                        Hacé clic en el mapa para seleccionar un punto de encuentro.
                    </div>
                    {{ form_widget(form.latitud) }}
                    {{ form_widget(form.longitud) }}
                </div>
                {{ form_row(form.activo) }}
                <button class="btn btn-primary w-100" type="submit">{{ editing ? 'Guardar cambios' : 'Crear destino' }}</button>
                {{ form_end(form) }}
                {% if editing %}
                    <a class="btn btn-link mt-2" href="{{ path('app_admin_transfer_destinations') }}">Crear un nuevo destino</a>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="col-lg-7">
        <div class="card shadow-sm">
            <div class="card-body">
                <div class="d-flex flex-wrap align-items-center justify-content-between mb-3">
                    <h2 class="h5 mb-0">Destinos configurados</h2>
                    <a class="btn btn-sm btn-outline-secondary" href="{{ path('app_admin_transfer_destination_categories') }}">Administrar categorías</a>
                </div>
                <form method="get" class="row g-2 mb-3">
                    <div class="col-md-5">
                        <label for="destino-busqueda" class="form-label visually-hidden">Buscar</label>
                        <input type="search"
                               class="form-control"
                               id="destino-busqueda"
                               name="q"
                               value="{{ filtros.q }}"
                               placeholder="Buscar por nombre o descripción corta">
                    </div>
                    <div class="col-md-4">
                        <label for="destino-categoria" class="form-label visually-hidden">Categoría</label>
                        <select class="form-select" id="destino-categoria" name="categoria">
                            <option value="">Todas las categorías</option>
                            {% for categoria in categorias %}
                                <option value="{{ categoria.id }}" {{ filtros.categoria == categoria.id ? 'selected' : '' }}>{{ categoria.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-md-3 d-grid d-md-flex gap-2">
                        <button class="btn btn-primary flex-fill" type="submit">Aplicar filtros</button>
                        <a class="btn btn-outline-secondary flex-fill" href="{{ path('app_admin_transfer_destinations') }}">Limpiar</a>
                    </div>
                </form>
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>Portada</th>
                            <th>Nombre</th>
                            <th>Categoría</th>
                            <th>Descripción</th>
                            <th>Tarifa base</th>
                            <th>Ubicación</th>
                            <th>Estado</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                    {% for destino in destinos %}
                        <tr>
                            <td class="align-middle" style="width: 80px;">
                                {% if destino.imagenPrincipal %}
                                    <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal) }}" alt="{{ destino.nombre }}" class="img-thumbnail" style="max-width: 72px;">
                                {% else %}
                                    <span class="text-muted small">Sin imagen</span>
                                {% endif %}
                            </td>
                            <td class="align-middle">
                                <div class="fw-semibold">{{ destino.nombre }}</div>
                                {% if destino.direccion %}
                                    <div class="small text-muted">{{ destino.direccion }}</div>
                                {% endif %}
                            </td>
                            <td class="align-middle">
                                {% if destino.categoria %}
                                    <span class="badge rounded-pill bg-info-subtle text-info-emphasis">
                                        {% if destino.categoria.icono %}{{ destino.categoria.icono|raw }} {% endif %}{{ destino.categoria.nombre }}
                                    </span>
                                {% else %}
                                    <span class="text-muted small">Sin categoría</span>
                                {% endif %}
                            </td>
                            <td class="align-middle">
                                {% if destino.descripcionCorta %}
                                    <p class="small text-muted mb-0">{{ destino.descripcionCorta }}</p>
                                {% elseif destino.descripcion %}
                                    <p class="small text-muted mb-0">{{ destino.descripcion|striptags|u.truncate(100, '…') }}</p>
                                {% else %}
                                    <span class="text-muted small">Sin descripción</span>
                                {% endif %}
                            </td>
                            <td>${{ destino.tarifaBase }}</td>
                            <td>
                                {% if destino.latitude is not null and destino.longitude is not null %}
                                    <span class="small">{{ destino.latitude|number_format(4, '.', '') }}, {{ destino.longitude|number_format(4, '.', '') }}</span>
                                {% else %}
                                    <span class="text-muted small">Sin coordenadas</span>
                                {% endif %}
                            </td>
                            <td>
                                {% if destino.activo %}
                                    <span class="badge bg-success">Activo</span>
                                {% else %}
                                    <span class="badge bg-secondary">Inactivo</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                <a class="btn btn-sm btn-outline-primary" href="{{ path('app_admin_transfer_destination_edit', {id: destino.id}) }}">Editar</a>
                            </td>
                        </tr>
                    {% else %}
                        <tr><td colspan="5" class="text-center text-muted">Aún no hay destinos configurados.</td></tr>
                    {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
{% endblock %}
