{% extends 'base.html.twig' %}

{% block title %}Panel de chofer{% endblock %}

{% block body %}
<section class="container py-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <h1 class="mb-0">Panel de chofer</h1>
        {% if perfil and perfil.aprobado %}
            <a class="btn btn-primary" href="{{ path('app_driver_balance') }}">
                Ver balance
            </a>
        {% endif %}
    </div>

    {% for flashSuccess in app.flashes('success') %}
        <div class="alert alert-success">{{ flashSuccess }}</div>
    {% endfor %}
    {% for flashError in app.flashes('error') %}
        <div class="alert alert-danger">{{ flashError }}</div>
    {% endfor %}
    {% for flashInfo in app.flashes('info') %}
        <div class="alert alert-info">{{ flashInfo }}</div>
    {% endfor %}
    {% for flashWarning in app.flashes('warning') %}
        <div class="alert alert-warning">{{ flashWarning }}</div>
    {% endfor %}

    {% set selectedFeatureIds = [] %}
    {% if perfil %}
        {% for feature in perfil.vehicleFeatures %}
            {% set selectedFeatureIds = selectedFeatureIds|merge([feature.id]) %}
        {% endfor %}
    {% endif %}

    {% if not perfil %}
        <div class="alert alert-warning">
            Todavía no completaste tu registro de chofer. Solicitá el enlace privado al administrador para cargar tus datos.
        </div>
    {% elseif not perfil.aprobado %}
        <div class="alert alert-info">
            Tu perfil está en revisión. Te avisaremos cuando el administrador lo apruebe para que puedas capturar traslados.
        </div>
    {% else %}
        <div class="row g-4">
            <div class="col-lg-8">
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Mis traslados activos</h2>
                        {% if asignaciones %}
                            <div class="list-group list-group-flush">
                                {% for asignacion in asignaciones %}
                                    {% set solicitud = asignacion.solicitud %}
                                    <div class="list-group-item">
                                        <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                            <div>
                                                <h3 class="h6 mb-1">{{ solicitud.nombrePasajero }}</h3>
                                                <div class="small text-muted">Código: {{ solicitud.tokenSeguimiento }}</div>
                                                <div class="small">Inicio del servicio: {{ solicitud.arribo ? solicitud.arribo|date('d/m/Y H:i') : 'Sin dato' }}</div>
                                                <div class="small">Fin del servicio: {{ solicitud.salida ? solicitud.salida|date('d/m/Y H:i') : 'Sin dato' }}</div>
                                                {% if solicitud.cantidadPasajeros %}
                                                    <div class="small">Pasajeros: {{ solicitud.cantidadPasajeros }}</div>
                                                {% endif %}
                                                <div class="small">Total: ${{ solicitud.precioTotal }}</div>
                                                <div class="mt-2">
                                                    <a class="btn btn-link p-0" href="{{ path('app_transfer_tracking', {token: solicitud.tokenSeguimiento}) }}" target="_blank">Ver seguimiento público</a>
                                                </div>
                                            </div>
                                            <div class="text-end">
                                                <span class="badge bg-secondary text-uppercase">{{ asignacion.estado|replace({'_':' '}) }}</span>
                                                <div class="small text-muted">Paradas completadas: {{ asignacion.paradaActual }}/{{ solicitud.destinos|length }}</div>
                                            </div>
                                        </div>
                                        <hr>
                                        <h4 class="h6">Paradas del viaje</h4>
                                        <ol class="small ps-3">
                                            {% for destino in solicitud.destinos %}
                                                <li class="mb-1{% if loop.index <= asignacion.paradaActual %} text-decoration-line-through text-success{% endif %}">
                                                    {{ destino.destino.nombre }}
                                                </li>
                                            {% else %}
                                                <li class="text-muted">Sin destinos registrados.</li>
                                            {% endfor %}
                                        </ol>
                                        <div class="mt-3 d-flex flex-wrap gap-2">
                                            <form method="post" action="{{ path('app_driver_assignment_next', {id: asignacion.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('next_stop_' ~ asignacion.id) }}">
                                                <button class="btn btn-outline-primary btn-sm" type="submit">Siguiente parada</button>
                                            </form>
                                            <form method="post" action="{{ path('app_driver_assignment_complete', {id: asignacion.id}) }}">
                                                <input type="hidden" name="_token" value="{{ csrf_token('complete_transfer_' ~ asignacion.id) }}">
                                                <button class="btn btn-success btn-sm" type="submit">Finalizar viaje</button>
                                            </form>
                                            <form method="post" action="{{ path('app_driver_assignment_cancel', {id: asignacion.id}) }}" onsubmit="return confirm('¿Seguro que querés liberar este traslado?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('cancel_transfer_' ~ asignacion.id) }}">
                                                <button class="btn btn-outline-danger btn-sm" type="submit">Cancelar</button>
                                            </form>
                                        </div>
                                        {% set cashPayment = solicitud.cashPayments|last %}
                                        {% if cashPayment %}
                                            <div class="mt-3 p-3 border rounded bg-light">
                                                <div class="d-flex justify-content-between align-items-start flex-wrap gap-2">
                                                    <div>
                                                        <div class="small text-muted">Pago en efectivo</div>
                                                        <div class="fw-semibold text-uppercase small">{{ cashPayment.status|replace({'_':' '}) }}</div>
                                                        {% if cashPayment.driverReportedAt %}
                                                            <div class="small text-muted">Reportado: {{ cashPayment.driverReportedAt|date('d/m/Y H:i') }}</div>
                                                        {% endif %}
                                                        {% if cashPayment.adminConfirmedAt %}
                                                            <div class="small text-success">Confirmado por administración: {{ cashPayment.adminConfirmedAt|date('d/m/Y H:i') }}</div>
                                                        {% endif %}
                                                    </div>
                                                    <div class="d-flex gap-2">
                                                        {% if cashPayment.status == constant('App\\Entity\\CashPayment::STATUS_PENDING') %}
                                                            <form method="post" action="{{ path('app_driver_transfer_cash', {id: solicitud.id}) }}">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('driver_cash_' ~ solicitud.id) }}">
                                                                <input type="hidden" name="action" value="report">
                                                                <button class="btn btn-sm btn-outline-success" type="submit">Informar entrega</button>
                                                            </form>
                                                        {% elseif cashPayment.status == constant('App\\Entity\\CashPayment::STATUS_DRIVER_REPORTED') %}
                                                            <form method="post" action="{{ path('app_driver_transfer_cash', {id: solicitud.id}) }}" onsubmit="return confirm('¿Querés revertir el registro de entrega?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('driver_cash_' ~ solicitud.id) }}">
                                                                <input type="hidden" name="action" value="revert">
                                                                <button class="btn btn-sm btn-outline-secondary" type="submit">Revertir registro</button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <div class="small text-muted mt-2">Monto: {{ cashPayment.currency }} {{ cashPayment.amount|number_format(2, ',', '.') }}</div>
                                            </div>
                                        {% endif %}
                                        <form method="post" action="{{ path('app_driver_assignment_notes', {id: asignacion.id}) }}" class="mt-3">
                                            <input type="hidden" name="_token" value="{{ csrf_token('notes_transfer_' ~ asignacion.id) }}">
                                            <label class="form-label small">Notas internas</label>
                                            <textarea name="nota" class="form-control" rows="2">{{ asignacion.notas }}</textarea>
                                            <button class="btn btn-link btn-sm px-0" type="submit">Guardar notas</button>
                                        </form>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">Todavía no capturaste ningún traslado. Elegí uno disponible a la derecha.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
            <div class="col-lg-4">
                {% if perfil %}
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Mi vehículo</h2>
                            {% if perfil.vehicleFeatures|length > 0 %}
                                <div class="mb-3">
                                    <span class="small text-muted d-block mb-1">Características actuales</span>
                                    <div class="d-flex flex-wrap gap-2">
                                        {% for feature in perfil.vehicleFeatures %}
                                            <span class="badge bg-light text-dark border">{{ feature.nombre }}</span>
                                        {% endfor %}
                                    </div>
                                </div>
                            {% endif %}
                            <form method="post" action="{{ path('app_driver_vehicle_update') }}">
                                <input type="hidden" name="_token" value="{{ csrf_token('driver_vehicle_' ~ perfil.id) }}">
                                <div class="mb-3">
                                    <label class="form-label small">Tipo de vehículo</label>
                                    <select name="vehicle_type" class="form-select form-select-sm">
                                        <option value="">Seleccioná el tipo de vehículo</option>
                                        {% for tipo in vehicleTypes %}
                                            <option value="{{ tipo.id }}"{% if perfil.vehicleType and perfil.vehicleType.id == tipo.id %} selected{% endif %}>{{ tipo.nombre }}</option>
                                        {% endfor %}
                                    </select>
                                    {% if vehicleTypes is empty %}
                                        <small class="text-danger">Solicitá al administrador que configure los tipos de vehículo disponibles.</small>
                                    {% endif %}
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Características disponibles</label>
                                    <div class="border rounded p-2" style="max-height: 160px; overflow-y: auto;">
                                        {% for feature in vehicleFeatures %}
                                            <div class="form-check mb-1">
                                                <input class="form-check-input" type="checkbox" name="features[]" value="{{ feature.id }}" id="driver_feature_{{ feature.id }}"{% if feature.id in selectedFeatureIds %} checked{% endif %}>
                                                <label class="form-check-label small" for="driver_feature_{{ feature.id }}">{{ feature.nombre }}</label>
                                            </div>
                                        {% else %}
                                            <p class="small text-muted mb-0">No hay características predefinidas por ahora.</p>
                                        {% endfor %}
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label small">Agregar características nuevas</label>
                                    <input type="text" name="new_features" class="form-control form-control-sm" placeholder="Ej: WiFi a bordo, Agua mineral">
                                    <small class="text-muted">Separá cada característica con una coma.</small>
                                </div>
                                <button class="btn btn-primary btn-sm w-100" type="submit">Guardar vehículo</button>
                            </form>
                        </div>
                    </div>
                {% endif %}
                <div class="card shadow-sm">
                    <div class="card-body">
                        <h2 class="h5 mb-3">Traslados disponibles</h2>
                        {% if disponibles %}
                            <div class="list-group list-group-flush">
                                {% for solicitud in disponibles %}
                                    <div class="list-group-item">
                                        <div class="fw-semibold">{{ solicitud.nombrePasajero }}</div>
                                        <div class="small text-muted">Inicio del servicio: {{ solicitud.arribo ? solicitud.arribo|date('d/m/Y H:i') : 'Sin dato' }}</div>
                                        <div class="small">Paradas: {{ solicitud.destinos|length }}</div>
                                        {% if solicitud.cantidadPasajeros %}
                                            <div class="small">Pasajeros: {{ solicitud.cantidadPasajeros }}</div>
                                        {% endif %}
                                        <div class="small mb-2">Total: ${{ solicitud.precioTotal }}</div>
                                        <form method="post" action="{{ path('app_driver_capture', {id: solicitud.id}) }}">
                                            <input type="hidden" name="_token" value="{{ csrf_token('capture_transfer_' ~ solicitud.id) }}">
                                            <button class="btn btn-outline-primary btn-sm w-100" type="submit">Capturar viaje</button>
                                        </form>
                                    </div>
                                {% endfor %}
                            </div>
                        {% else %}
                            <p class="text-muted mb-0">No hay traslados pendientes por ahora.</p>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</section>
{% endblock %}
