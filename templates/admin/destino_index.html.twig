{% extends 'administrador/base.html.twig' %}

{% block title %}Destinos turísticos - Admin{% endblock %}

{% block body %}
    <div class="contenedor">
        <div class="encabezado-section d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <h1 class="h3 mb-1">Destinos turísticos</h1>
                <p class="text-muted mb-0">Gestioná la información que aparece en la web y en el mapa interactivo.</p>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="{{ path('app_admin_destino_categorias') }}">
                    <span class="bi bi-tags me-2"></span>Categorías
                </a>
                <a class="btn btn-primary" href="{{ path('app_admin_destino_new') }}">
                    <span class="bi bi-plus-lg me-2"></span>Nuevo destino
                </a>
            </div>
        </div>

        <div class="card toa-card p-4 mt-4">
            {{ form_start(filterForm, { attr: { class: 'row g-3 align-items-end' } }) }}
                <div class="col-md-6 col-lg-4">
                    {{ form_label(filterForm.q, null, { label_attr: { class: 'form-label fw-semibold text-muted text-uppercase small' } }) }}
                    {{ form_widget(filterForm.q, { attr: { class: 'form-control' } }) }}
                </div>
                <div class="col-md-6 col-lg-4">
                    {{ form_label(filterForm.categoria, null, { label_attr: { class: 'form-label fw-semibold text-muted text-uppercase small' } }) }}
                    {{ form_widget(filterForm.categoria, { attr: { class: 'form-select' } }) }}
                </div>
                <div class="col-md-12 col-lg-4 d-flex gap-2">
                    <button class="btn btn-primary flex-fill" type="submit">
                        <span class="bi bi-search me-2"></span>Buscar
                    </button>
                    <a class="btn btn-outline-secondary flex-fill" href="{{ path('app_admin_destino_index') }}">
                        <span class="bi bi-arrow-counterclockwise me-2"></span>Restablecer
                    </a>
                </div>
            {{ form_end(filterForm) }}
        </div>

        <div class="row mt-4 g-4">
            {% for destino in destinos %}
                <div class="col-12 col-lg-6">
                    <div class="card toa-card h-100">
                        <div class="row g-0 h-100">
                            <div class="col-md-5">
                                {% if destino.imagenPrincipal %}
                                    <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal)|imagine_filter('destino_card') }}" class="img-fluid rounded-start h-100 object-fit-cover" alt="{{ destino.nombre }}">
                                {% else %}
                                    <div class="h-100 d-flex align-items-center justify-content-center bg-light rounded-start text-muted">Sin imagen</div>
                                {% endif %}
                            </div>
                            <div class="col-md-7">
                                <div class="card-body d-flex flex-column gap-2 h-100">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <h2 class="h5 mb-0">{{ destino.nombre }}</h2>
                                        <span class="toa-badge-soft">{{ destino.categoria.nombre }}</span>
                                    </div>
                                    <p class="small text-muted mb-0">{{ destino.descripcionCorta }}</p>
                                    <div class="d-flex flex-wrap gap-2 small text-muted">
                                        <span class="bi bi-geo-alt"></span>
                                        <span>{{ destino.direccion }}</span>
                                    </div>
                                    <div class="d-flex gap-2 mt-auto">
                                        <a class="btn btn-outline-primary btn-sm" href="{{ path('app_admin_destino_edit', { id: destino.id }) }}">
                                            <span class="bi bi-pencil-square me-1"></span>Editar
                                        </a>
                                        <form method="post" action="{{ path('app_admin_destino_delete', { id: destino.id }) }}" onsubmit="return confirm('¿Seguro que querés eliminar este destino?');">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete_destino_' ~ destino.id) }}">
                                            <button class="btn btn-outline-danger btn-sm" type="submit">
                                                <span class="bi bi-trash me-1"></span>Eliminar
                                            </button>
                                        </form>
                                        <a class="btn btn-link ms-auto" href="{{ path('app_destino_show', { id: destino.id }) }}" target="_blank">
                                            Ver en la web
                                        </a>
                                    </div>
                                    <div class="d-flex gap-3 small text-muted">
                                        {% if destino.coordenadasLat is not null and destino.coordenadasLng is not null %}
                                            <span><span class="bi bi-compass me-1"></span>{{ destino.coordenadasLat }}, {{ destino.coordenadasLng }}</span>
                                        {% else %}
                                            <span class="text-warning"><span class="bi bi-exclamation-triangle me-1"></span>Coordenadas pendientes</span>
                                        {% endif %}
                                        <span><span class="bi {{ destino.activo ? 'bi-eye text-success' : 'bi-eye-slash text-muted' }} me-1"></span>{{ destino.activo ? 'Publicado' : 'Oculto' }}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="col-12">
                    <div class="alert alert-info">No encontramos destinos con los filtros seleccionados.</div>
                </div>
            {% endfor %}
        </div>
    </div>
{% endblock %}
