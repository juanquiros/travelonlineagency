{% extends 'administrador/base.html.twig' %}

{% block title %}Categorías de destinos{% endblock %}

{% block body %}
    <div class="contenedor">
        <div class="encabezado-section d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
            <div>
                <h1 class="h3 mb-1">Categorías de destinos</h1>
                <p class="text-muted mb-0">Organizá los destinos por temática para personalizar tarjetas y marcadores.</p>
            </div>
            <a class="btn btn-outline-secondary" href="{{ path('app_admin_destino_index') }}">
                <span class="bi bi-arrow-left me-2"></span>Volver a destinos
            </a>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card toa-card p-4 h-100">
                    <h2 class="h5 mb-3">Crear nueva categoría</h2>
                    {{ form_start(form) }}
                        <div class="mb-3">
                            {{ form_label(form.nombre, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                            {{ form_widget(form.nombre, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(form.nombre) }}
                        </div>
                        <div class="mb-3">
                            {{ form_label(form.icono, null, { label_attr: { class: 'form-label fw-semibold' } }) }}
                            {{ form_widget(form.icono, { attr: { class: 'form-control font-monospace', rows: 2 } }) }}
                            <div class="form-text">Pegá código HTML o un ícono de Bootstrap Icons.</div>
                            {{ form_errors(form.icono) }}
                        </div>
                        <button class="btn btn-primary" type="submit">
                            <span class="bi bi-plus-lg me-2"></span>Guardar categoría
                        </button>
                    {{ form_end(form) }}
                </div>
            </div>
            <div class="col-lg-7">
                <div class="card toa-card p-4">
                    <h2 class="h5 mb-3">Categorías existentes</h2>
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Nombre</th>
                                    <th>Ícono</th>
                                    <th class="text-end">Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for categoria in categorias %}
                                    <tr>
                                        <td class="fw-semibold">{{ categoria.nombre }}</td>
                                        <td><span class="categoria-icono" aria-hidden="true">{{ categoria.icono|raw }}</span></td>
                                        <td class="text-end">
                                            <a class="btn btn-outline-primary btn-sm" href="{{ path('app_admin_destino_categoria_edit', { id: categoria.id }) }}">
                                                <span class="bi bi-pencil me-1"></span>Editar
                                            </a>
                                            <form method="post" action="{{ path('app_admin_destino_categoria_delete', { id: categoria.id }) }}" class="d-inline" onsubmit="return confirm('¿Eliminar la categoría {{ categoria.nombre }}?');">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_destino_categoria_' ~ categoria.id) }}">
                                                <button class="btn btn-outline-danger btn-sm" type="submit">
                                                    <span class="bi bi-trash me-1"></span>Eliminar
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="3" class="text-center text-muted">Aún no hay categorías cargadas.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
