{% if bookings %}
    <div class="row g-4 justify-content-center">
        {% for booking in bookings %}
            {% set bookingFechas = booking.getfechasdisponibles %}
            {% set tradBooking = booking.getTraduccionOPorDefecto(idiomaPlataforma.codigo) %}
            <div class="col-sm-6 col-xl-4">
                <div class="card toa-card h-100">
                    <img src="{{ asset('img/booking/' ~ booking.getImgPortada) }}" class="card-img-top" alt="{{ tradBooking.nombre }}">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h3 class="h5 mb-0">{{ tradBooking.nombre }}</h3>
                            {% if booking.getLugaresDisponibles['total'] == 1 %}
                                <span class="toa-pill"><i class="bi bi-exclamation-triangle"></i> Último lugar</span>
                            {% endif %}
                        </div>
                        <p class="text-muted small flex-grow-1">{{ tradBooking.descripcion }}</p>

                        {% if bookingFechas %}
                            {% if booking.getLugaresDisponibles['total'] > 0 %}
                                <a class="btn btn-primary w-100 mt-2" href="{{ path('app_reserva', {id: booking.id}) }}">Reservar ahora</a>
                            {% else %}
                                <button class="btn btn-outline-secondary w-100 mt-2" disabled>Sin lugares disponibles</button>
                            {% endif %}
                        {% else %}
                            <button class="btn btn-outline-secondary w-100 mt-2" disabled>Sin fechas disponibles</button>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-5">
        <p class="text-muted mb-0">No se encontraron reservas disponibles por el momento.</p>
    </div>
{% endif %}
