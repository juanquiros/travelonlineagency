{% extends 'base.html.twig' %}

{% block title %}Home - Travel Online Agency{% endblock %}

{% block body %}
    <section class="home-jumbo" data-aos="fade-up"
              data-aos-duration="2000" >
        <div class="row-home-h1"  style="background:linear-gradient(rgba(0,0,0,0.9), rgba(0,0,0,0.6)),url({{ asset('img/waterfall.jpg') }}); background-position-y: 40%">
            <img src="{{ asset('img/'~ plataforma.logo) }}" alt="" style="height: 10em">
            <h1>{{ plataforma.nombre }}</h1>
        </div>
    </section>
    <section id="bookings"   data-aos="fade-up" data-aos-duration="2000">
        <div class="row">
            <div class="col-md-12 center">
                <h2>{{ cfg_bookings['titulo'] }}</h2>
                <hr>
                {% if cfg_bookings['descripcion'] %}
                    <div class="row">
                        <div class="col-md-4"></div>
                        <div class="col-md-4">
                            <p class="text-center">
                                    {{ cfg_bookings['descripcion'] }}
                            </p>
                            <hr>
                        </div>
                        <div class="col-md-4"></div>
                    </div>
                {% endif %}
                <div class="row">
                    <div class="col-md-3"></div>
                    <div class="col-md-6">
                        <nav class="navbar navbar-expand-lg navbar-light bg-light" style="display: flex; flex-direction: row; justify-content: space-evenly">
                                <ul class="navbar-nav mr-auto">
                                    <li class="nav-item">
                                        <a class="nav-link" onclick="getBookingsbyfecha('{{ 'now' | date('Y-m-d') }}')">Ver todo</a>
                                    </li>
                                </ul>
                                <form class="form-inline my-2 my-lg-0" style="display: flex; flex-direction: row;">
                                    <label for="filtrofecha" class="mr-5">Seleccionar un día</label>
                                    <input type="date" id="filtrofecha" class="form-control" onchange="getBookingsbyfecha()" min="{{ now | date('Y-m-d') }}">
                                </form>
                        </nav>
                        <hr>
                    </div>
                    <div class="col-md-3"></div>
                </div>
                <div class="row center" id="bookingrowinicio">
                    {% include 'inicio/bookings.html.twig' %}
                </div>
            </div>
        </div>
    </section>
    <section data-aos="fade-up" data-aos-duration="1500">
        <div class="row" >
            <div class="col-md-12 center">
                <h2>{{ cfg_traslados['titulo'] }}</h2>
                <hr>
                {% if cfg_traslados['descripcion'] %}
                    <div class="row">
                        <div class="col-md-4"></div>
                        <div class="col-md-4">
                            <p class="text-center">{{ cfg_traslados['descripcion'] }}</p>
                            <hr>
                        </div>
                        <div class="col-md-4"></div>
                    </div>
                {% endif %}
                <div class="row gy-4 justify-content-center">
                    {% for combo in transferCombos %}
                        <div class="col-md-4 d-flex">
                            <div class="card shadow-sm flex-fill h-100">
                                {% if combo.imagenPortada %}
                                    <img src="{{ asset('img/transfer/' ~ combo.imagenPortada) }}" class="card-img-top" alt="{{ combo.nombre }}">
                                {% endif %}
                                <div class="card-body">
                                    <h3 class="h5">{{ combo.nombre }}</h3>
                                    <p class="text-success fw-semibold">${{ combo.precio }}</p>
                                    {% if combo.descripcion %}
                                        <p class="small text-muted">{{ combo.descripcion|striptags|u.truncate(150, '…') }}</p>
                                    {% endif %}
                                    {% if combo.destinos|length > 0 %}
                                        <div class="small text-muted">
                                            <strong>Incluye:</strong>
                                            {% for enlace in combo.destinos %}
                                                <span class="badge bg-light text-dark border">{{ enlace.destino.nombre }}</span>
                                            {% endfor %}
                                        </div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="col-12 text-center text-muted">Pronto publicaremos nuevos combos de traslado.</div>
                    {% endfor %}
                </div>
                {% if transferDestinations %}
                    <div class="row gy-4 justify-content-center mt-3">
                        {% for destino in transferDestinations %}
                            <div class="col-md-3 d-flex">
                                <div class="card border-0 bg-light flex-fill h-100">
                                    {% if destino.imagenPortada %}
                                        <img src="{{ asset('img/transfer/' ~ destino.imagenPortada) }}" class="card-img-top" alt="{{ destino.nombre }}">
                                    {% endif %}
                                    <div class="card-body">
                                        <h4 class="h6">{{ destino.nombre }}</h4>
                                        <p class="text-success fw-semibold">Tarifa base: ${{ destino.tarifaBase }}</p>
                                        {% if destino.descripcion %}
                                            <p class="small text-muted mb-0">{{ destino.descripcion|striptags|u.truncate(120, '…') }}</p>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
                {% set mappedDestinations = [] %}
                {% for destino in transferDestinations %}
                    {% if destino.latitude is not null and destino.longitude is not null %}
                        {% set mappedDestinations = mappedDestinations|merge([
                            {
                                'nombre': destino.nombre,
                                'lat': destino.latitude,
                                'lng': destino.longitude,
                                'descripcion': destino.descripcion ? destino.descripcion|striptags|u.truncate(120, '…') : null,
                                'tarifa': destino.tarifaBase,
                                'moneda': 'ARS'
                            }
                        ]) %}
                    {% endif %}
                {% endfor %}
                <div class="text-center mt-4">
                    <a class="btn btn-outline-primary" href="{{ path('app_transfers') }}">Planificá tu traslado</a>
                    {% if not customTransfersEnabled %}
                        <p class="small text-muted mt-2">Los traslados personalizados se activarán pronto. Mientras tanto, podés reservar cualquiera de nuestros combos.</p>
                    {% endif %}
                </div>
                {% if mappedDestinations|length > 0 %}
                    {% set firstPoint = mappedDestinations[0] %}
                    <div class="card shadow-sm mt-3 mx-auto" style="max-width: 900px;">
                        <div class="card-body">
                            <h3 class="h6 text-uppercase text-muted">Mapa de destinos</h3>
                            <div class="ratio ratio-4x3"
                                 data-controller="transfer-destinations-overview"
                                 data-transfer-destinations-overview-destinations-value="{{ mappedDestinations|json_encode(constant('JSON_UNESCAPED_UNICODE'))|e('html_attr') }}"
                                 data-transfer-destinations-overview-lat-value="{{ firstPoint.lat }}"
                                 data-transfer-destinations-overview-lng-value="{{ firstPoint.lng }}">
                                <div data-transfer-destinations-overview-target="map" class="w-100 h-100 rounded" style="min-height: 260px;"></div>
                            </div>
                            <div class="alert alert-warning mt-3 d-none" data-transfer-destinations-overview-target="fallback">
                                No pudimos cargar el mapa en este momento. Actualizá la página para volver a intentarlo.
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </section>
    <section data-aos="fade-up" >
        <div class="w-100 text-center center" style="padding: 0.5em;">
            <h3>Social media</h3>
            <hr>
        </div>
        <div class="text-center" style="display: flex;flex-direction: row; width: 100%; justify-content: center; font-size: 2.5em">
            {%  if plataforma.linkInstagram != '' %}
                <a href="{{ plataforma.linkInstagram }}" style="margin: 0.5em" target="_blank">
                    <span class="mbr-iconfont bi bi-instagram"></span>
                </a>
            {% endif %}
            {%  if plataforma.linkInstagram != '' %}
                <a href="{{ plataforma.linkWhatsapp }}" style="margin: 0.5em" target="_blank">
                    <span class="mbr-iconfont bi bi-whatsapp"></span>
                </a>
            {% endif %}
        </div>

    </section>
{% endblock %}
