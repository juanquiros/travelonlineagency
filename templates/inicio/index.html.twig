{% extends 'base.html.twig' %}

{% block title %}Home - Travel Online Agency{% endblock %}

{% block body %}
    <section class="toa-hero" data-aos="fade-up" data-aos-duration="2000" style="background-image: linear-gradient(135deg, rgba(12, 45, 74, 0.92), rgba(31, 107, 179, 0.92)), url({{ asset('img/waterfall.jpg') }}); background-size: cover; background-position: center;">
        <div class="toa-hero-content">
            <div class="d-flex flex-column gap-3">
                <span class="toa-hero-badge"><span class="bi bi-airplane-engines"></span> Experiencias en Iguazú</span>
                <h1 class="toa-hero-title">{{ plataforma.nombre }}</h1>
                <p class="toa-hero-subtitle">Planificá tus reservas y traslados con una agencia online creada para acompañarte en cada paso del viaje.</p>
                <div class="toa-hero-actions">
                    <a class="toa-btn-primary btn" href="{{ path('app_transfers') }}">Planificá tu traslado</a>
                    <a class="toa-btn-outline btn" href="{{ path('app_inicio') }}#bookings">Ver servicios disponibles</a>
                </div>
            </div>
            <div class="d-none d-md-flex justify-content-end">
                <img src="{{ asset('img/'~ plataforma.logo) }}" alt="{{ plataforma.nombre }}" class="img-fluid" style="max-height: 220px; filter: drop-shadow(0 20px 35px rgba(0,0,0,0.25));">
            </div>
        </div>
    </section>

    <section id="bookings" class="toa-section" data-aos="fade-up" data-aos-duration="2000">
        <div class="container">
            <h2 class="toa-section-title">{{ cfg_bookings['titulo'] }}</h2>
            <div class="section-divider"></div>
            {% if cfg_bookings['descripcion'] %}
                <p class="toa-section-subtitle">{{ cfg_bookings['descripcion'] }}</p>
            {% endif %}

            <div class="booking-filter-card">
                <div class="d-flex flex-column flex-lg-row align-items-lg-center justify-content-between gap-3">
                    <div>
                        <h3 class="h6 text-uppercase text-muted mb-1">Buscar disponibilidad</h3>
                        <p class="small text-muted mb-0">Elegí una fecha para descubrir experiencias únicas.</p>
                    </div>
                    <div class="d-flex flex-column flex-sm-row gap-3 align-items-sm-center">
                        <button class="btn btn-link text-decoration-none fw-semibold" onclick="getBookingsbyfecha('{{ 'now' | date('Y-m-d') }}')">
                            <span class="bi bi-arrow-repeat me-2"></span>Ver todas las fechas
                        </button>
                        <div>
                            <label for="filtrofecha" class="form-label mb-1">Seleccioná un día</label>
                            <input type="date" id="filtrofecha" class="form-control" onchange="getBookingsbyfecha()" min="{{ now | date('Y-m-d') }}">
                        </div>
                    </div>
                </div>
            </div>

            <div class="row" id="bookingrowinicio">
                {% include 'inicio/bookings.html.twig' %}
            </div>
        </div>
    </section>

    <section class="toa-section" data-aos="fade-up" data-aos-duration="1500">
        <div class="container">
            <h2 class="toa-section-title">{{ cfg_traslados['titulo'] }}</h2>
            <div class="section-divider"></div>
            {% if cfg_traslados['descripcion'] %}
                <p class="toa-section-subtitle">{{ cfg_traslados['descripcion'] }}</p>
            {% endif %}

            <div class="row gy-4 justify-content-center">
                {% for combo in transferCombos %}
                    <div class="col-md-6 col-lg-4 d-flex">
                        <div class="card toa-card flex-fill h-100">
                            {% if combo.imagenPortada %}
                                <img src="{{ asset('img/transfer/' ~ combo.imagenPortada) }}" class="card-img-top" alt="{{ combo.nombre }}">
                            {% endif %}
                            <div class="card-body d-flex flex-column gap-3">
                                <div class="d-flex justify-content-between align-items-start">
                                    <h3 class="h5 mb-0">{{ combo.nombre }}</h3>
                                    <span class="toa-pill"><span class="bi bi-cash-coin"></span>${{ combo.precio }}</span>
                                </div>
                                {% if combo.descripcion %}
                                    <p class="small text-muted mb-0">{{ combo.descripcion|striptags|u.truncate(160, '…') }}</p>
                                {% endif %}
                                {% if combo.destinos|length > 0 %}
                                    <div>
                                        <span class="text-uppercase small text-muted fw-semibold">Incluye</span>
                                        <ul class="toa-list-inline mt-2">
                                            {% for enlace in combo.destinos %}
                                                <li>{{ enlace.destino.nombre }}</li>
                                            {% endfor %}
                                        </ul>
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% else %}
                    <div class="col-12 text-center text-muted">Pronto publicaremos nuevos combos de traslado.</div>
                {% endfor %}
            </div>

            <div class="text-center mt-4">
                <a class="toa-btn-primary btn" href="{{ path('app_transfers') }}">Planificá tu traslado</a>
                {% if not customTransfersEnabled %}
                    <p class="small text-muted mt-2">Los traslados personalizados se activarán pronto. Mientras tanto, podés reservar cualquiera de nuestros combos.</p>
                {% endif %}
            </div>
        </div>
    </section>

    <section class="toa-section bg-light" data-aos="fade-up" data-aos-duration="1500">
        <div class="container">
            <h2 class="toa-section-title">Destinos destacados</h2>
            <div class="section-divider"></div>
            <p class="toa-section-subtitle">Conocé los lugares que recomendamos para planificar tus experiencias en Iguazú.</p>
            <div class="mb-4">
                {% include 'home/_mapa.html.twig' with {
                    apiUrl: path('api_destinos_index'),
                    destinosData: destinosTuristicos
                } %}
            </div>
            <div class="row g-4">
                {% for destino in destinosTuristicos|slice(0, 6) %}
                    <div class="col-md-6 col-lg-4 d-flex">
                        {% include 'components/destino_card.html.twig' with { destino: destino } %}
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">Muy pronto publicaremos los primeros destinos destacados.</div>
                    </div>
                {% endfor %}
            </div>
            <div class="text-center mt-4">
                <a class="btn btn-outline-primary" href="{{ path('app_destinos') }}">Ver todos los destinos</a>
            </div>
        </div>
    </section>

    <section class="toa-section" data-aos="fade-up">
        <div class="container text-center">
            <h2 class="toa-section-title">Seguinos en redes</h2>
            <div class="section-divider"></div>
            <p class="toa-section-subtitle">Enterate de las últimas novedades, promociones y experiencias diseñadas para que disfrutes al máximo tu viaje.</p>
            <div class="toa-social-links justify-content-center">
                {% if plataforma.linkInstagram != '' %}
                    <a href="{{ plataforma.linkInstagram }}" target="_blank" aria-label="Instagram"><span class="bi bi-instagram"></span></a>
                {% endif %}
                {% if plataforma.linkWhatsapp != '' %}
                    <a href="{{ plataforma.linkWhatsapp }}" target="_blank" aria-label="WhatsApp"><span class="bi bi-whatsapp"></span></a>
                {% endif %}
            </div>
        </div>
    </section>
{% endblock %}
