{% if bookings %}
    <div class="row g-4">
        {% for booking in bookings %}
            <div class="col-sm-6 col-xl-4">
                <div class="card toa-card h-100">
                    <img src="{{ asset('img/booking/' ~ booking.getImgPortada) }}" class="card-img-top" alt="{{ booking.nombre }}">
                    <div class="card-body d-flex flex-column">
                        <h3 class="h5">{{ booking.nombre }}</h3>
                        <p class="text-muted small flex-grow-1">{{ booking.descripcion }}</p>
                        <a class="btn btn-primary w-100 mt-2" href="{{ path('app_reserva', {id: booking.id}) }}">Reservar ahora</a>
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>
{% else %}
    <div class="text-center py-5">
        <p class="text-muted mb-0">No se encontraron reservas disponibles.</p>
    </div>
{% endif %}
