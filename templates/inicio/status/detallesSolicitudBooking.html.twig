{% if booking %}
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm text-center">
                <div class="card-header py-4">
                    <h2 class="h5 mb-0">Reserva de {{ booking.booking.nombre }}</h2>
                    <p class="text-muted small mb-0">Código #{{ booking.id }}</p>
                </div>
                <div class="card-body p-5">
                    <h3 class="h5">Titular: {{ booking.name }} {{ booking.surname }}</h3>
                    <p class="text-muted">Estado actual: {{ booking.estado.getnombreporlenguaje(idiomaPlataforma.codigo).traduccion }}</p>

                    {% if booking.estado.id == 1 %}
                        <div class="alert alert-info text-start">
                            <strong>Tu reserva sigue pendiente de pago.</strong><br>
                            Elegí un método para abonar desde el botón inferior o continua con el que ya seleccionaste.
                        </div>
                        <a class="btn btn-primary mb-3" href="{{ opcionesPagoUrl }}">Ver opciones de pago</a>
                    {% endif %}

                    {% if pago %}
                        <div class="alert alert-primary text-start">
                            Tenés un pago iniciado con PayPal pendiente de confirmación.
                            <a class="alert-link" href="{{ pago.linkPago }}" target="_blank">Finalizar pago</a>
                        </div>
                    {% endif %}

                    {% if pagoEfectivo %}
                        <div class="alert alert-warning text-start">
                            <h4 class="h6">Pago en efectivo solicitado</h4>
                            <p class="mb-1">Monto a abonar: <strong>{{ pagoEfectivo.amount|number_format(2, ',', '.') }} {{ pagoEfectivo.currency }}</strong></p>
                            {% if pagoEfectivo.notes %}
                                <p class="mb-0">{{ pagoEfectivo.notes|nl2br }}</p>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% if adicionales | length > 0 %}
                        <hr class="my-4">
                        <h4 class="h6">Acompañantes</h4>
                        <ul class="list-unstyled small text-start d-inline-block">
                            {% for reserva in adicionales %}
                                <li>{{ reserva.name }} {{ reserva.surname }}</li>
                            {% endfor %}
                        </ul>
                    {% endif %}

                    <hr class="my-4">
                    <h4 class="h6 mb-3">Escaneá el código para revisar la reserva</h4>
                    <img class="img-fluid" style="max-width: 180px" src="{{ qr_code_url(melink) }}" alt="Código QR de la reserva">
                </div>
            </div>
        </div>
    </div>
{% endif %}
