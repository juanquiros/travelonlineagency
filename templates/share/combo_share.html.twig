<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', Arial, sans-serif; background: #06182c; color: #0c2d4a; }
        .share-card { width: 1080px; height: 1920px; display: grid; grid-template-rows: 60% 40%; border-radius: 64px; overflow: hidden; background: linear-gradient(200deg, #0c2d4a 0%, #123c68 40%, #081c33 100%); position: relative; }
        .share-image { position: relative; overflow: hidden; }
        .share-image::before { content: ''; position: absolute; inset: 0; background: linear-gradient(200deg, rgba(5,18,33,0.1) 0%, rgba(5,18,33,0.4) 55%, rgba(5,18,33,0.85) 100%); z-index: 1; }
        .share-image::after { content: ''; position: absolute; inset: 64px; border-radius: 48px; border: 2px solid rgba(255,255,255,0.18); z-index: 2; }
        .share-image__media { position: absolute; inset: 0; background-size: cover; background-position: center; transform: scale(1.05); }
        .share-header { position: absolute; top: 72px; left: 72px; right: 72px; z-index: 3; display: flex; justify-content: space-between; align-items: center; color: #fff; }
        .share-header__tag { display: inline-flex; gap: 10px; align-items: center; background: rgba(255,255,255,0.14); padding: 14px 24px; border-radius: 999px; font-size: 28px; text-transform: uppercase; letter-spacing: 4px; }
        .share-header__tag span { color: #ffd394; font-weight: 600; }
        .share-header__logo { width: 160px; height: 160px; border-radius: 48px; background: rgba(255,255,255,0.15); display: grid; place-items: center; backdrop-filter: blur(14px); border: 2px solid rgba(255,255,255,0.35); }
        .share-header__logo img { width: 96px; height: 96px; }
        .share-title { position: absolute; left: 72px; right: 72px; bottom: 120px; z-index: 3; color: #ffffff; display: grid; gap: 22px; }
        .share-title h1 { font-size: 88px; line-height: 1.05; }
        .share-title__meta { display: inline-flex; gap: 18px; align-items: center; }
        .share-title__meta span { background: rgba(255,255,255,0.18); padding: 12px 24px; border-radius: 999px; font-size: 30px; letter-spacing: 2px; }
        .share-title__meta strong { font-size: 42px; color: #ffd394; }
        .share-body { background: #f7f9fc; border-top-left-radius: 56px; border-top-right-radius: 56px; padding: 96px; display: flex; flex-direction: column; justify-content: space-between; gap: 64px; box-shadow: inset 0 18px 36px rgba(6,24,44,0.18); }
        .share-body__info { display: flex; flex-direction: column; gap: 32px; }
        .share-body__price { display: inline-flex; align-items: center; gap: 14px; padding: 16px 28px; border-radius: 999px; background: rgba(20,100,162,0.12); color: #0c2d4a; font-size: 36px; font-weight: 600; }
        .share-body__destinos { display: grid; gap: 16px; font-size: 30px; color: #2f475f; }
        .share-body__destinos span { display: inline-flex; gap: 12px; align-items: center; }
        .share-body__destinos span::before { content: '•'; color: #d97b0d; font-size: 38px; line-height: 1; }
        .share-body p { font-size: 32px; line-height: 1.6; color: #2f475f; max-width: 760px; }
        .share-body__cta { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
        .share-body__cta-text { display: flex; flex-direction: column; gap: 14px; }
        .share-body__cta-text span { font-size: 26px; color: #d97b0d; text-transform: uppercase; letter-spacing: 2px; }
        .share-body__cta-text h2 { font-size: 44px; color: #0c2d4a; }
        .share-qr { position: relative; display: inline-flex; padding: 24px; border-radius: 42px; background: linear-gradient(150deg, rgba(217,123,13,0.2), rgba(18,100,162,0.2)); box-shadow: 0 28px 60px rgba(12,45,74,0.28); }
        .share-qr__frame { position: relative; border-radius: 32px; overflow: hidden; background: #ffffff; padding: 24px 24px 32px; display: grid; justify-items: center; gap: 22px; }
        .share-qr__code { width: 360px; height: 360px; display: block; filter: drop-shadow(0 12px 26px rgba(12,45,74,0.2)); }
        .share-qr__logo { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 104px; height: 104px; border-radius: 36px; background: rgba(255,255,255,0.97); display: grid; place-items: center; box-shadow: 0 16px 36px rgba(12,45,74,0.28); border: 4px solid rgba(12,45,74,0.16); }
        .share-qr__logo img { width: 62px; height: 62px; }
        .share-qr__label { font-size: 26px; font-weight: 600; color: #0c2d4a; letter-spacing: 1px; }
    </style>
</head>
<body>
<div class="share-card">
    <div class="share-image">
        <div class="share-image__media" style="background-image: url('{{ imageUrl ?: fallbackImageUrl }}');"></div>
        <div class="share-header">
            <div class="share-header__tag">
                <span>Traslados</span>
                Iguazú
            </div>
            <div class="share-header__logo">
                <img src="{{ logoUrl }}" alt="Travel Online Agency"/>
            </div>
        </div>
        <div class="share-title">
            <h1>{{ combo.nombre }}</h1>
            <div class="share-title__meta">
                <span>Combo exclusivo</span>
                <strong>#TrasladosIguazú</strong>
            </div>
        </div>
    </div>
    <div class="share-body">
        <div class="share-body__info">
            <div class="share-body__price">Tarifa desde ${{ combo.precio|number_format(0, ',', '.') }}</div>
            {% if combo.descripcion %}
                <p>{{ combo.descripcion|striptags|u.truncate(420, '…') }}</p>
            {% endif %}
            {% if destinos is not empty %}
                <div class="share-body__destinos">
                    {% for destino in destinos|slice(0,5) %}
                        <span>{{ destino.nombre }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        <div class="share-body__cta">
            <div class="share-body__cta-text">
                <span>Travel Online Agency</span>
                <h2>Escaneá y asegura tu traslado ideal</h2>
            </div>
            <div class="share-qr">
                <div class="share-qr__frame">
                    <div class="share-qr__logo">
                        <img src="{{ logoUrl }}" alt="Travel Online Agency"/>
                    </div>
                    <img class="share-qr__code" src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
                    <div class="share-qr__label">Reservá ahora</div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
