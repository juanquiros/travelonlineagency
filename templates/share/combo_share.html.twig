<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', Arial, sans-serif; background: #0c2d4a; color: #0c2d4a; }
        .share-card { width: 1200px; height: 675px; display: grid; grid-template-columns: 55% 45%; border-radius: 36px; overflow: hidden; background: #ffffff; }
        .share-image { background-size: cover; background-position: center; position: relative; }
        .share-image::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, rgba(12,45,74,0.1) 0%, rgba(12,45,74,0.55) 100%); }
        .share-body { padding: 40px; display: flex; flex-direction: column; gap: 24px; justify-content: space-between; }
        .share-body h1 { font-size: 48px; line-height: 1.1; color: #0c2d4a; }
        .share-body p { font-size: 22px; color: #4f6f8a; }
        .share-price { display: inline-flex; align-items: center; gap: 12px; background: rgba(31,107,179,0.1); color: #1f6bb3; padding: 12px 20px; border-radius: 999px; font-weight: 600; font-size: 24px; }
        .share-destinos { display: flex; flex-direction: column; gap: 8px; }
        .share-destinos span { font-size: 20px; color: #0c2d4a; }
        .share-footer { display: flex; justify-content: space-between; align-items: flex-end; }
        .share-brand span { font-size: 20px; color: #d97b0d; text-transform: uppercase; letter-spacing: 4px; }
        .share-brand strong { font-size: 32px; color: #0c2d4a; }
        .share-qr { position: relative; display: inline-flex; padding: 16px; border-radius: 26px; background: linear-gradient(135deg, rgba(12,45,74,0.12), rgba(217,123,13,0.12)); box-shadow: 0 18px 48px rgba(12,45,74,0.22); }
        .share-qr__frame { position: relative; border-radius: 22px; overflow: hidden; background: #fff; padding: 12px; }
        .share-qr__code { width: 170px; height: 170px; display: block; filter: drop-shadow(0 8px 18px rgba(12,45,74,0.16)); }
        .share-qr__logo { position: absolute; inset: 50%; transform: translate(-50%, -50%); width: 64px; height: 64px; border-radius: 22px; background: rgba(255,255,255,0.95); display: grid; place-items: center; box-shadow: 0 12px 24px rgba(12,45,74,0.25); border: 3px solid rgba(12,45,74,0.12); }
        .share-qr__logo img { width: 40px; height: 40px; }
    </style>
</head>
<body>
<div class="share-card">
    <div class="share-image" style="background-image: url('{{ imageUrl ?: fallbackImageUrl }}');"></div>
    <div class="share-body">
        <div>
            <h1>{{ combo.nombre }}</h1>
            <div class="share-price">${{ combo.precio }}</div>
            {% if combo.descripcion %}
                <p>{{ combo.descripcion|striptags|u.truncate(180, '…') }}</p>
            {% endif %}
            {% if destinos is not empty %}
                <div class="share-destinos">
                    {% for destino in destinos|slice(0,4) %}
                        <span>• {{ destino.nombre }}</span>
                    {% endfor %}
                </div>
            {% endif %}
        </div>
        <div class="share-footer">
            <div class="share-brand">
                <span>Travel Online Agency</span>
                <strong>#TrasladosIguazú</strong>
            </div>
            <div class="share-qr">
                <div class="share-qr__frame">
                    <img class="share-qr__code" src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
                    <div class="share-qr__logo">
                        <img src="{{ logoUrl }}" alt="Travel Online Agency"/>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
