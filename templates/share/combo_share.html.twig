<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            width: 1080px;
            height: 1920px;
            font-family: 'Poppins', Arial, sans-serif;
            background: linear-gradient(175deg, #05142a 0%, #0e3053 45%, #174f73 100%);
            color: #f4f7ff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 220px 160px 200px;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('{{ imageUrl ?: fallbackImageUrl }}');
            background-size: cover;
            background-position: center;
            opacity: 0.25;
            filter: saturate(120%) contrast(110%);
            mix-blend-mode: screen;
        }
        body::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(70% 70% at 18% 20%, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 72%),
                        radial-gradient(85% 85% at 82% 88%, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.86) 75%);
            pointer-events: none;
        }
        .share {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        .share__top {
            display: flex;
            flex-direction: column;
            gap: 96px;
        }
        .share__brand {
            display: flex;
            align-items: center;
            gap: 56px;
        }
        .share__logo {
            width: 220px;
            height: 220px;
            border-radius: 48px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
        }
        .share__logo img {
            max-width: 150px;
            max-height: 150px;
        }
        .share__text {
            display: flex;
            flex-direction: column;
            gap: 26px;
        }
        .share__platform {
            font-size: 34px;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: rgba(255, 211, 148, 0.95);
        }
        .share__title {
            font-size: 108px;
            line-height: 1.05;
            letter-spacing: -1px;
            text-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
        }
        .share__address {
            font-size: 42px;
            color: rgba(244, 248, 255, 0.9);
        }
        .share__destinos {
            display: flex;
            flex-wrap: wrap;
            gap: 18px;
            margin-top: 12px;
        }
        .share__destino-tag {
            display: inline-flex;
            align-items: center;
            gap: 12px;
            padding: 14px 22px;
            border-radius: 999px;
            background: rgba(6, 24, 44, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.18);
            font-size: 28px;
            color: rgba(244, 248, 255, 0.92);
        }
        .share__qr {
            align-self: flex-end;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 36px;
            padding: 48px 48px 64px;
            border-radius: 40px;
            background: rgba(6, 24, 44, 0.55);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(12px);
        }
        .share__qr img {
            width: 420px;
            height: 420px;
        }
        .share__qr span {
            font-size: 32px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #ffdca8;
        }
    </style>
</head>
<body>
<div class="share">
    <div class="share__top">
        <div class="share__brand">
            <div class="share__logo">
                <img src="{{ platformIconUrl }}" alt="{{ platformName }}"/>
            </div>
            <div class="share__text">
                <span class="share__platform">{{ platformName }}</span>
                <h1 class="share__title">{{ combo.nombre }}</h1>
                <p class="share__address">{{ primaryAddress ?: 'Puerto Iguazú, Misiones' }}</p>
                {% if destinos is not empty %}
                    <div class="share__destinos">
                        {% for destino in destinos|slice(0, 4) %}
                            <span class="share__destino-tag">{{ destino.nombre }}</span>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>
        </div>
    </div>
    <div class="share__qr">
        <img src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
        <span>Escaneá y reservá tu traslado</span>
    </div>
</div>
</body>
</html>
