<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        {% set gradients = [
            'linear-gradient(170deg, #030914 0%, #10213a 50%, #1a3b58 100%)',
            'linear-gradient(165deg, #040b17 0%, #0f1f33 48%, #1c3a55 100%)',
            'linear-gradient(168deg, #020711 0%, #0c192b 44%, #18344c 100%)',
            'linear-gradient(172deg, #010813 0%, #0e1d31 54%, #1b3a53 100%)'
        ] %}
        {% set backgroundGradient = gradients|random %}
        body {
            width: 1080px;
            height: 1920px;
            font-family: 'Poppins', Arial, sans-serif;
            background: {{ backgroundGradient }};
            color: #f4f7ff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 220px 160px 200px;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('{{ imageUrl ?: fallbackImageUrl }}');
            background-size: cover;
            background-position: center;
            opacity: 0.25;
            filter: saturate(120%) contrast(110%);
            mix-blend-mode: screen;
        }
        body::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(70% 70% at 18% 20%, rgba(255, 255, 255, 0.16) 0%, rgba(255, 255, 255, 0) 72%),
                        radial-gradient(85% 85% at 82% 88%, rgba(0, 0, 0, 0.5) 0%, rgba(0, 0, 0, 0.86) 75%);
            pointer-events: none;
        }
        .share {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        .share__top {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 70px;
        }
        .share__logo {
            width: 220px;
            height: 220px;
            display: block;
            object-fit: contain;
            filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.55));
        }
        .share__title {
            font-size: 108px;
            line-height: 1.05;
            letter-spacing: -1px;
            text-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
        }
        .share__address {
            font-size: 42px;
            color: rgba(244, 248, 255, 0.9);
        }
        .share__qr {
            align-self: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 36px;
            padding: 48px 48px 64px;
            border-radius: 40px;
            background: rgba(6, 24, 44, 0.55);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(12px);
        }
        .share__qr img {
            width: 420px;
            height: 420px;
        }
        .share__qr span {
            font-size: 32px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #ffdca8;
        }
        .share__list {
            margin-top: 48px;
            font-size: 32px;
            color: rgba(244, 248, 255, 0.9);
            text-align: center;
            line-height: 1.6;
        }
        .share__list-title {
            text-transform: uppercase;
            letter-spacing: 4px;
            font-size: 28px;
            color: rgba(255, 220, 168, 0.92);
        }
    </style>
</head>
<body>
<div class="share">
    <div class="share__top">
        <img class="share__logo" src="{{ platformIconUrl }}" alt="{{ platformName }}"/>
        <h1 class="share__title">{{ combo.nombre }}</h1>
        <p class="share__address">{{ primaryAddress ?: 'Puerto Iguazú, Misiones' }}</p>
    </div>
    <div class="share__qr">
        <img src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
        <span>Escaneá y reservá tu traslado</span>
    </div>
    {% if destinos is not empty %}
        {% set destinoNombres = destinos|map(attribute='nombre') %}
        <div class="share__list">
            <div class="share__list-title">Destinos del combo</div>
            {{ destinoNombres|join(', ') }}
        </div>
    {% endif %}
</div>
</body>
</html>
