<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        {% set gradients = [
            'linear-gradient(162deg, #020b19 0%, #11233f 48%, #173a59 100%)',
            'linear-gradient(168deg, #040a16 0%, #101d33 52%, #1b3a54 100%)',
            'linear-gradient(170deg, #030611 0%, #091728 46%, #153349 100%)',
            'linear-gradient(165deg, #010a1b 0%, #0c1f37 55%, #124260 100%)'
        ] %}
        {% set backgroundGradient = random(gradients) %}
        body {
            width: 1080px;
            height: 1920px;
            font-family: 'Poppins', Arial, sans-serif;
            background-color: #020b19;
            background-image: {{ backgroundGradient }};
            background-repeat: no-repeat;
            background-size: cover;
            color: #f6f9ff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 220px 160px 200px;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('{{ imageUrl ?: fallbackImageUrl }}');
            background-size: cover;
            background-position: center;
            opacity: 0.28;
            filter: saturate(115%) contrast(105%);
            mix-blend-mode: screen;
        }
        body::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(65% 65% at 20% 15%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%),
                        radial-gradient(90% 90% at 80% 85%, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.85) 75%);
            pointer-events: none;
        }
        .share {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        .share__top {
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
            gap: 72px;
        }
        .share__logo {
            width: 220px;
            height: 220px;
            display: block;
            object-fit: contain;
            filter: drop-shadow(0 22px 40px rgba(0, 0, 0, 0.55));
        }
        .share__title {
            font-size: 112px;
            line-height: 1.04;
            letter-spacing: -2px;
            text-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
        }
        .share__address {
            font-size: 44px;
            color: rgba(244, 248, 255, 0.88);
        }
        .share__qr {
            align-self: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 36px;
            padding: 48px 48px 64px;
            border-radius: 40px;
            background: rgba(6, 24, 44, 0.55);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(12px);
        }
        .share__qr img {
            width: 420px;
            height: 420px;
        }
        .share__qr span {
            font-size: 32px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #ffdca8;
        }
    </style>
</head>
<body>
<div class="share">
    <div class="share__top">
        <img class="share__logo" src="{{ platformIconUrl }}" alt="{{ platformName }}"/>
        <h1 class="share__title">{{ destino.nombre }}</h1>
        <p class="share__address">{{ destino.direccion ?: 'Puerto Iguazú, Misiones' }}</p>
    </div>
    <div class="share__qr">
        <img src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
        <span>Escaneá y descubrí Iguazú</span>
    </div>
</div>
</body>
</html>
