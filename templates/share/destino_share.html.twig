<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Poppins', Arial, sans-serif; background: #06182c; color: #0c2d4a; }
        .share-card { width: 1080px; height: 1920px; display: grid; grid-template-rows: 65% 35%; border-radius: 64px; overflow: hidden; background: linear-gradient(180deg, #0c2d4a 0%, #0f3a64 35%, #0c2d4a 100%); position: relative; }
        .share-image { position: relative; overflow: hidden; }
        .share-image::before { content: ''; position: absolute; inset: 0; background-image: linear-gradient(180deg, rgba(6,24,44,0.1) 0%, rgba(6,24,44,0.35) 50%, rgba(6,24,44,0.85) 100%); z-index: 1; }
        .share-image::after { content: ''; position: absolute; inset: 64px; border-radius: 48px; border: 2px solid rgba(255,255,255,0.15); z-index: 2; }
        .share-image__media { position: absolute; inset: 0; background-size: cover; background-position: center; transform: scale(1.02); }
        .share-header { position: absolute; top: 72px; left: 72px; right: 72px; z-index: 3; display: flex; justify-content: space-between; align-items: center; color: #fff; }
        .share-header__tag { display: inline-flex; gap: 10px; align-items: center; background: rgba(255,255,255,0.12); padding: 14px 24px; border-radius: 999px; font-size: 28px; letter-spacing: 4px; text-transform: uppercase; }
        .share-header__tag span { color: #ffd394; font-weight: 600; }
        .share-header__logo { width: 160px; height: 160px; border-radius: 48px; background: rgba(255,255,255,0.12); display: grid; place-items: center; backdrop-filter: blur(12px); border: 2px solid rgba(255,255,255,0.3); }
        .share-header__logo img { width: 96px; height: 96px; }
        .share-title { position: absolute; left: 72px; right: 72px; bottom: 132px; z-index: 3; color: #ffffff; }
        .share-title h1 { font-size: 96px; line-height: 1.05; margin-bottom: 18px; }
        .share-title p { font-size: 36px; max-width: 720px; color: rgba(255,255,255,0.82); }
        .share-body { background: #f7f9fc; border-top-left-radius: 56px; border-top-right-radius: 56px; padding: 96px 96px 120px; display: flex; flex-direction: column; justify-content: space-between; gap: 64px; box-shadow: inset 0 16px 32px rgba(12,45,74,0.12); }
        .share-body__info { display: flex; flex-direction: column; gap: 28px; }
        .share-body__meta { display: flex; gap: 32px; flex-wrap: wrap; color: #4f6f8a; font-size: 28px; }
        .share-body__meta span { display: inline-flex; align-items: center; gap: 12px; padding: 12px 22px; border-radius: 999px; background: rgba(15,74,115,0.08); color: #0c2d4a; font-weight: 600; }
        .share-body__cta { display: flex; justify-content: space-between; align-items: flex-end; gap: 48px; }
        .share-body__cta-text { display: flex; flex-direction: column; gap: 12px; }
        .share-body__cta-text h2 { font-size: 42px; color: #0c2d4a; }
        .share-body__cta-text span { font-size: 26px; color: #d97b0d; letter-spacing: 2px; text-transform: uppercase; }
        .share-qr { position: relative; display: inline-flex; padding: 24px; border-radius: 42px; background: linear-gradient(140deg, rgba(217,123,13,0.18), rgba(15,74,115,0.22)); box-shadow: 0 28px 60px rgba(12,45,74,0.28); }
        .share-qr__frame { position: relative; border-radius: 32px; overflow: hidden; background: #ffffff; padding: 24px 24px 32px; display: grid; justify-items: center; gap: 22px; }
        .share-qr__label { font-size: 26px; font-weight: 600; color: #0c2d4a; letter-spacing: 1px; }
        .share-qr__code { width: 360px; height: 360px; display: block; filter: drop-shadow(0 12px 24px rgba(12,45,74,0.18)); }
        .share-qr__logo { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 104px; height: 104px; border-radius: 36px; background: rgba(255,255,255,0.97); display: grid; place-items: center; box-shadow: 0 16px 36px rgba(12,45,74,0.28); border: 4px solid rgba(12,45,74,0.16); }
        .share-qr__logo img { width: 62px; height: 62px; }
    </style>
</head>
<body>
<div class="share-card">
    <div class="share-image">
        <div class="share-image__media" style="background-image: url('{{ imageUrl ?: fallbackImageUrl }}');"></div>
        <div class="share-header">
            <div class="share-header__tag">
                <span>Iguazú</span>
                Experiencia Natural
            </div>
            <div class="share-header__logo">
                <img src="{{ logoUrl }}" alt="Travel Online Agency"/>
            </div>
        </div>
        <div class="share-title">
            <h1>{{ destino.nombre }}</h1>
            <p>{{ destino.descripcionCorta ?: 'Viví Iguazú con Travel Online Agency.' }}</p>
        </div>
    </div>
    <div class="share-body">
        <div class="share-body__info">
            <div class="share-body__meta">
                {% if destino.categoria %}
                    <span>{{ destino.categoria.nombre }}</span>
                {% endif %}
                {% if destino.direccion %}
                    <span>{{ destino.direccion }}</span>
                {% endif %}
            </div>
            <p style="font-size:32px; line-height:1.5; color:#2f475f; max-width: 740px;">
                {{ destino.descripcionDetallada ? destino.descripcionDetallada|striptags|u.truncate(420, '…') : 'Descubrí los encantos de Puerto Iguazú con guías locales, experiencias auténticas y traslados integrales para tu viaje soñado.' }}
            </p>
        </div>
        <div class="share-body__cta">
            <div class="share-body__cta-text">
                <span>Travel Online Agency</span>
                <h2>Escaneá y reservá tu próxima aventura</h2>
            </div>
            <div class="share-qr">
                <div class="share-qr__frame">
                    <div class="share-qr__logo">
                        <img src="{{ logoUrl }}" alt="Travel Online Agency"/>
                    </div>
                    <img class="share-qr__code" src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
                    <div class="share-qr__label">Descubrí Iguazú</div>
                </div>
            </div>
        </div>
    </div>
</div>
</body>
</html>
