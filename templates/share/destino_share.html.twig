<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        html, body { height: 100%; }
        body {
            width: 1080px;
            height: 1920px;
            font-family: 'Poppins', Arial, sans-serif;
            background: linear-gradient(165deg, #031226 0%, #0b2f4f 50%, #125070 100%);
            color: #f6f9ff;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            padding: 220px 160px 200px;
            position: relative;
            overflow: hidden;
        }
        body::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: url('{{ imageUrl ?: fallbackImageUrl }}');
            background-size: cover;
            background-position: center;
            opacity: 0.28;
            filter: saturate(115%) contrast(105%);
            mix-blend-mode: screen;
        }
        body::after {
            content: '';
            position: absolute;
            inset: 0;
            background: radial-gradient(65% 65% at 20% 15%, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 70%),
                        radial-gradient(90% 90% at 80% 85%, rgba(0, 0, 0, 0.45) 0%, rgba(0, 0, 0, 0.85) 75%);
            pointer-events: none;
        }
        .share {
            position: relative;
            z-index: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 100%;
        }
        .share__top {
            display: flex;
            flex-direction: column;
            gap: 96px;
        }
        .share__brand {
            display: flex;
            align-items: center;
            gap: 56px;
        }
        .share__logo {
            width: 220px;
            height: 220px;
            border-radius: 48px;
            background: rgba(255, 255, 255, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.35);
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.4);
        }
        .share__logo img {
            max-width: 150px;
            max-height: 150px;
        }
        .share__text {
            display: flex;
            flex-direction: column;
            gap: 28px;
        }
        .share__platform {
            font-size: 34px;
            letter-spacing: 6px;
            text-transform: uppercase;
            color: rgba(255, 211, 148, 0.95);
        }
        .share__title {
            font-size: 112px;
            line-height: 1.04;
            letter-spacing: -2px;
            text-shadow: 0 18px 40px rgba(0, 0, 0, 0.55);
        }
        .share__address {
            font-size: 44px;
            color: rgba(244, 248, 255, 0.88);
        }
        .share__qr {
            align-self: flex-end;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 36px;
            padding: 48px 48px 64px;
            border-radius: 40px;
            background: rgba(6, 24, 44, 0.55);
            box-shadow: 0 30px 80px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(12px);
        }
        .share__qr img {
            width: 420px;
            height: 420px;
        }
        .share__qr span {
            font-size: 32px;
            letter-spacing: 4px;
            text-transform: uppercase;
            color: #ffdca8;
        }
    </style>
</head>
<body>
<div class="share">
    <div class="share__top">
        <div class="share__brand">
            <div class="share__logo">
                <img src="{{ platformIconUrl }}" alt="{{ platformName }}"/>
            </div>
            <div class="share__text">
                <span class="share__platform">{{ platformName }}</span>
                <h1 class="share__title">{{ destino.nombre }}</h1>
                <p class="share__address">{{ destino.direccion ?: 'Puerto Iguazú, Misiones' }}</p>
            </div>
        </div>
    </div>
    <div class="share__qr">
        <img src="{{ qr_code_data_uri(shareUrl, 'share_card') }}" alt="Código QR"/>
        <span>Escaneá y descubrí Iguazú</span>
    </div>
</div>
</body>
</html>
