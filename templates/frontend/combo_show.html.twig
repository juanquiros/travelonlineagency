{% extends 'base.html.twig' %}

{% block title %}{{ combo.nombre }} - Travel Online Agency{% endblock %}

{% block body %}
    <section class="toa-hero" style="background-image: linear-gradient(135deg, rgba(12,45,74,0.92), rgba(31,107,179,0.92)), url({{ combo.imagenPortada ? asset('img/transfer/' ~ combo.imagenPortada) : asset('img/iguazu-hero.svg') }}); background-size: cover; background-position: center;">
        <div class="toa-hero-content">
            <div class="d-flex flex-column gap-3">
                <span class="toa-hero-badge"><span class="bi bi-shuffle"></span> Combo de traslado</span>
                <h1 class="toa-hero-title">{{ combo.nombre }}</h1>
                {% if combo.descripcion %}
                    <p class="toa-hero-subtitle">{{ combo.descripcion|striptags|u.truncate(180, '…') }}</p>
                {% endif %}
                <div class="toa-hero-actions">
                    <a class="toa-btn-primary btn" href="{{ path('app_transfers') }}">Reservar este combo</a>
                    <a class="toa-btn-outline btn" href="{{ path('app_destinos') }}#combos">Ver todos los combos</a>
                </div>
            </div>
        </div>
    </section>

    <section class="toa-section" id="combo-detalle" data-aos="fade-up">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body d-flex flex-column gap-4">
                            {% include 'components/share_actions.html.twig' with {
                                shareUrl: shareUrl,
                                shareText: 'Conocé el combo ' ~ combo.nombre ~ ' de Travel Online Agency',
                                downloadUrl: path('app_transfer_combo_share_image', { id: combo.id }),
                                downloadLabel: 'Descargar imagen con QR'
                            } %}
                            <div class="d-flex flex-wrap align-items-center gap-3">
                                <span class="badge text-bg-primary fs-6">${{ combo.precio }}</span>
                                <span class="text-muted">Traslado curado por nuestro equipo local.</span>
                            </div>
                            {% if combo.descripcion %}
                                <div class="toa-content">{{ combo.descripcion|raw }}</div>
                            {% endif %}
                            {% if destinos is not empty %}
                                <div>
                                    <h2 class="h5 mb-3">Itinerario del combo</h2>
                                    <ol class="list-unstyled d-flex flex-column gap-3 mb-0">
                                        {% for destino in destinos %}
                                            <li class="border rounded p-3 d-flex flex-column gap-2">
                                                <div class="d-flex justify-content-between align-items-start">
                                                    <a class="fw-semibold text-decoration-none" href="{{ path('app_destino_show', { id: destino.id }) }}">{{ destino.nombre }}</a>
                                                    {% if destino.categoria %}
                                                        <span class="badge bg-info-subtle text-info-emphasis">
                                                            {% if destino.categoria.icono %}{{ destino.categoria.icono|raw }} {% endif %}{{ destino.categoria.nombre }}
                                                        </span>
                                                    {% endif %}
                                                </div>
                                                {% if destino.descripcionCorta %}
                                                    <p class="small text-muted mb-0">{{ destino.descripcionCorta }}</p>
                                                {% endif %}
                                            </li>
                                        {% endfor %}
                                    </ol>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h6 text-uppercase text-muted mb-3">Destinos en el mapa</h2>
                            {% set json_flags = constant('JSON_UNESCAPED_UNICODE') b-or constant('JSON_HEX_TAG') b-or constant('JSON_HEX_APOS') b-or constant('JSON_HEX_QUOT') b-or constant('JSON_HEX_AMP') %}
                            {% set mapa_json = mapDestinos is not empty ? mapDestinos|json_encode(json_flags) : null %}
                            <div class="rounded border"
                                 data-controller="destinos-map"
                                 data-destinos-map-default-lat-value="{{ mapDefaults.lat }}"
                                 data-destinos-map-default-lng-value="{{ mapDefaults.lng }}"
                                 data-destinos-map-single-value="false"
                                 {% if mapa_json %}data-destinos-map-destinos-value="{{ mapa_json|e('html_attr') }}"{% endif %}
                                 style="height: 320px;">
                                {% if mapa_json %}
                                    <script type="application/json" data-destinos-map-target="dataset">{{ mapa_json|raw }}</script>
                                {% endif %}
                                <div data-destinos-map-target="map" class="h-100"></div>
                                <div class="alert alert-warning mt-3 d-none" data-destinos-map-target="fallback">
                                    No pudimos cargar el mapa en este momento.
                                </div>
                                <div class="destinos-map-filter d-none" data-destinos-map-target="filterContainer">
                                    <span class="form-label text-uppercase small text-muted mb-2 d-block">Filtrar por categoría</span>
                                    <div class="destinos-map-filter-list" data-destinos-map-target="filterList"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% if otrosCombos is not empty %}
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h2 class="h6 text-uppercase text-muted mb-3">Otros combos recomendados</h2>
                                <div class="d-flex flex-column gap-3">
                                    {% for otro in otrosCombos|slice(0,3) %}
                                        <div class="border rounded p-3 d-flex flex-column gap-2">
                                            <a class="fw-semibold text-decoration-none" href="{{ path('app_transfer_combo_show', { id: otro.id }) }}">{{ otro.nombre }}</a>
                                            <div class="d-flex align-items-center gap-2">
                                                <span class="badge text-bg-primary">${{ otro.precio }}</span>
                                                {% if otro.destinos|length > 0 %}
                                                    <span class="small text-muted">{{ otro.destinos|length }} paradas</span>
                                                {% endif %}
                                            </div>
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
