{% extends 'base.html.twig' %}

{% block title %}Destinos destacados - Travel Online Agency{% endblock %}

{% block body %}
    <section class="toa-hero" style="background-image: linear-gradient(135deg, rgba(12,45,74,0.92), rgba(31,107,179,0.92)), url({{ asset('img/iguazu-hero.svg') }}); background-size: cover; background-position: center;">
        <div class="toa-hero-content">
            <div class="d-flex flex-column gap-3">
                <span class="toa-hero-badge"><span class="bi bi-geo-alt"></span> Descubrí Iguazú</span>
                <h1 class="toa-hero-title">Destinos imperdibles</h1>
                <p class="toa-hero-subtitle">Inspirate con atractivos naturales, culturales y gastronómicos curados por nuestro equipo.</p>
                <div class="toa-hero-actions">
                    <a class="toa-btn-primary btn" href="#mapa-destinos">Ver mapa interactivo</a>
                    <a class="toa-btn-outline btn" href="#destinos">Ver todos los destinos</a>
                </div>
            </div>
        </div>
    </section>

    <section class="toa-section bg-light" data-aos="fade-up" data-aos-duration="1200">
        <div class="container">
            <div class="toa-search-card shadow-sm">
                <form class="row g-3 align-items-end" action="{{ path('app_destinos') }}" method="get">
                    <div class="col-lg-5">
                        <label class="form-label text-uppercase small fw-semibold text-muted" for="buscar-destinos">Buscar destinos</label>
                        <input type="search" id="buscar-destinos" name="q" value="{{ term }}" class="form-control" placeholder="Cataratas, gastronomía, aventura…">
                    </div>
                    <div class="col-lg-4">
                        <label class="form-label text-uppercase small fw-semibold text-muted" for="filtrar-categoria">Filtrar por categoría</label>
                        <select id="filtrar-categoria" name="categoria" class="form-select">
                            <option value="">Todas las categorías</option>
                            {% for categoria in categorias %}
                                <option value="{{ categoria.id }}" {{ categoriaSeleccionada == categoria.id ? 'selected' : '' }}>{{ categoria.nombre }}</option>
                            {% endfor %}
                        </select>
                    </div>
                    <div class="col-lg-3 d-flex gap-2">
                        <button class="btn btn-primary flex-fill" type="submit"><span class="bi bi-search me-2"></span>Buscar</button>
                        {% if term or categoriaSeleccionada %}
                            <a class="btn btn-outline-secondary" href="{{ path('app_destinos') }}">Limpiar</a>
                        {% endif %}
                    </div>
                </form>
                {% if term or categoriaSeleccionada %}
                    <p class="small text-muted mb-0 mt-3"><span class="bi bi-funnel-fill me-1"></span>Mostrando resultados
                        {% if term %} que coinciden con “<strong>{{ term }}</strong>”{% endif %}
                        {% if categoriaSeleccionadaNombre %}
                            en la categoría <strong>{{ categoriaSeleccionadaNombre }}</strong>
                        {% endif %}
                    </p>
                {% endif %}
            </div>
        </div>
    </section>

    {% if combos is defined and combos is not empty %}
        <section id="combos" class="toa-section" data-aos="fade-up" data-aos-delay="150">
            <div class="container">
                <h2 class="toa-section-title">Combos de traslado destacados</h2>
                <div class="section-divider"></div>
                <p class="toa-section-subtitle">Elegí un paquete curado por nuestros especialistas para optimizar tu experiencia en Iguazú.</p>
                <div class="row g-4">
                    {% for combo in combos %}
                        <div class="col-md-6 col-lg-4 d-flex">
                            {% include 'components/combo_card.html.twig' with { combo: combo } %}
                        </div>
                    {% else %}
                        <div class="col-12">
                            <div class="alert alert-info">Estamos preparando nuevos combos de traslado. Volvé a visitarnos pronto.</div>
                        </div>
                    {% endfor %}
                </div>
            </div>
        </section>
    {% endif %}

    <section id="destinos" class="toa-section" data-aos="fade-up" data-aos-duration="1500">
        <div class="container">
            <h2 class="toa-section-title">Tarjetas informativas</h2>
            <div class="section-divider"></div>
            <p class="toa-section-subtitle">Explorá cada destino para ver galerías, datos útiles y los servicios que ofrecemos en la zona.</p>
            <div class="row g-4">
                {% for destino in destinos %}
                    <div class="col-md-6 col-lg-4 d-flex">
                        {% include 'components/destino_card.html.twig' with { destino: destino } %}
                    </div>
                {% else %}
                    <div class="col-12">
                        <div class="alert alert-info">
                            {% if term or categoriaSeleccionada %}
                                No encontramos destinos con los filtros seleccionados. <a href="{{ path('app_destinos') }}" class="alert-link">Limpiar filtros</a> para volver a ver el listado completo.
                            {% else %}
                                Pronto publicaremos los primeros destinos destacados. ¡Vuelvé más tarde!
                            {% endif %}
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </section>

    <section id="mapa-destinos" class="toa-section" data-aos="fade-up" data-aos-delay="150">
        <div class="container">
            {% include 'home/_mapa.html.twig' with {
                apiUrl: path('api_destinos_index'),
                destinosData: destinos
            } %}
        </div>
    </section>
{% endblock %}
