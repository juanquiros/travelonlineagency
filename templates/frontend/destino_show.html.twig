{% extends 'base.html.twig' %}

{% block title %}{{ destino.nombre }} - Travel Online Agency{% endblock %}

{% block body %}
    <section class="toa-hero" style="background-image: linear-gradient(135deg, rgba(12,45,74,0.92), rgba(31,107,179,0.92)), url({{ destino.imagenPrincipal ? asset('img/destinos/' ~ destino.imagenPrincipal) : asset('img/iguazu-hero.svg') }}); background-size: cover; background-position: center;">
        <div class="toa-hero-content">
            <div class="d-flex flex-column gap-3">
                {% if destino.logo %}
                    <div class="destino-hero-logo">
                        <img src="{{ asset('img/destinos/logos/' ~ destino.logo) }}" alt="Logo {{ destino.nombre }}">
                    </div>
                {% endif %}
                <span class="toa-hero-badge"><span class="bi bi-map"></span> {{ destino.categoria ? destino.categoria.nombre : 'Destino destacado' }}</span>
                <h1 class="toa-hero-title">{{ destino.nombre }}</h1>
                {% if destino.descripcionCorta %}
                    <p class="toa-hero-subtitle">{{ destino.descripcionCorta }}</p>
                {% endif %}
                <div class="toa-hero-actions">
                    <a class="toa-btn-primary btn" href="#detalles">Ver detalles</a>
                    <a class="toa-btn-outline btn" href="{{ path('app_destinos') }}">Volver al listado</a>
                </div>
            </div>
        </div>
    </section>

    <section id="detalles" class="toa-section" data-aos="fade-up">
        <div class="container">
            <div class="row g-4">
                <div class="col-lg-8">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            {% if destino.imagenPrincipal %}
                                <img src="{{ asset('img/destinos/' ~ destino.imagenPrincipal) }}" class="img-fluid rounded mb-4" alt="{{ destino.nombre }}">
                            {% endif %}
                            {% include 'components/share_actions.html.twig' with {
                                shareUrl: shareUrl,
                                shareText: 'Descubrí ' ~ destino.nombre ~ ' en Travel Online Agency',
                                downloadUrl: path('app_destino_share_image', { id: destino.id }),
                                downloadLabel: 'Descargar imagen con QR'
                            } %}
                            {% if destino.direccion %}
                                <p class="text-muted"><span class="bi bi-geo-alt"></span> {{ destino.direccion }}</p>
                            {% endif %}
                            <div class="toa-content">{{ destino.descripcionDetallada ? destino.descripcionDetallada|raw : destino.descripcion|raw }}</div>
                        </div>
                    </div>
                </div>
                <div class="col-lg-4">
                    <div class="card shadow-sm mb-4">
                        <div class="card-body">
                            <h2 class="h5 mb-3">Ubicación</h2>
                            <div class="rounded border"
                                 data-controller="destino-map"
                                 data-destino-map-default-lat-value="{{ mapDefaults.lat }}"
                                 data-destino-map-default-lng-value="{{ mapDefaults.lng }}"
                                 data-destino-map-lat-value="{{ destino.coordenadasLat ?? mapDefaults.lat }}"
                                 data-destino-map-lng-value="{{ destino.coordenadasLng ?? mapDefaults.lng }}"
                                 data-destino-map-name-value="{{ destino.nombre }}"
                                 data-destino-map-editable-value="false"
                                 style="height: 280px;">
                                <input type="hidden"
                                       data-destino-map-target="lat"
                                       value="{{ destino.coordenadasLat ?? mapDefaults.lat }}">
                                <input type="hidden"
                                       data-destino-map-target="lng"
                                       value="{{ destino.coordenadasLng ?? mapDefaults.lng }}">
                                <div data-destino-map-target="map" class="h-100"></div>
                            </div>
                            {% if destino.categoria %}
                                <div class="mt-3">
                                    <span class="badge bg-info-subtle text-info-emphasis">
                                        {% if destino.categoria.icono %}{{ destino.categoria.icono|raw }} {% endif %}{{ destino.categoria.nombre }}
                                    </span>
                                </div>
                            {% endif %}
                            {% if destino.logo %}
                                <div class="mt-3 text-center">
                                    <span class="text-muted small d-block mb-2">Identidad del destino</span>
                                    <img src="{{ asset('img/destinos/logos/' ~ destino.logo) }}" alt="Logo {{ destino.nombre }}" style="width: 120px; height: 120px; object-fit: contain; background: #fff; border-radius: 24px; padding: 0.75rem; box-shadow: 0 10px 24px rgba(12, 45, 74, 0.08);">
                                </div>
                            {% endif %}
                        </div>
                    </div>
                    {% set redes = [
                        { 'url': destino.sitioWeb, 'icon': 'bi-globe', 'label': 'Sitio web oficial' },
                        { 'url': destino.instagram, 'icon': 'bi-instagram', 'label': 'Instagram' },
                        { 'url': destino.x, 'icon': 'bi-twitter-x bi-twitter', 'label': 'X (Twitter)' },
                        { 'url': destino.facebook, 'icon': 'bi-facebook', 'label': 'Facebook' },
                        { 'url': destino.whatsapp, 'icon': 'bi-whatsapp', 'label': 'WhatsApp' }
                    ] %}
                    {% set redes_activas = [] %}
                    {% for red in redes %}
                        {% if red.url is not empty %}
                            {% set redes_activas = redes_activas|merge([red]) %}
                        {% endif %}
                    {% endfor %}
                    {% if redes_activas is not empty %}
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <h2 class="h6 text-uppercase text-muted mb-3">Conectá con el destino</h2>
                                <p class="small text-muted">Visitá sus canales oficiales para conocer horarios, novedades y recomendaciones actualizadas.</p>
                                <div class="d-flex flex-column gap-2">
                                    {% for red in redes_activas %}
                                        <a class="btn btn-outline-secondary d-flex align-items-center justify-content-between" href="{{ red.url }}" target="_blank" rel="noopener">
                                            <span class="d-flex align-items-center gap-2">
                                                <span class="bi {{ red.icon }}"></span>
                                                <span>{{ red.label }}</span>
                                            </span>
                                            <span class="bi bi-box-arrow-up-right"></span>
                                        </a>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if combos is defined and combos is not empty %}
                        <div class="card shadow-sm mb-4">
                            <div class="card-body">
                                <h2 class="h6 text-uppercase text-muted mb-3">Combos que visitan este destino</h2>
                                <div class="d-flex flex-column gap-3">
                                    {% for combo in combos|slice(0,3) %}
                                        <div class="border rounded p-3 d-flex flex-column gap-2">
                                            <div class="d-flex justify-content-between align-items-start">
                                                <a class="fw-semibold text-decoration-none" href="{{ path('app_transfer_combo_show', { id: combo.id }) }}">{{ combo.nombre }}</a>
                                                <span class="badge text-bg-primary">${{ combo.precio }}</span>
                                            </div>
                                            {% if combo.descripcion %}
                                                <p class="small text-muted mb-0">{{ combo.descripcion|striptags|u.truncate(120, '…') }}</p>
                                            {% endif %}
                                        </div>
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    {% endif %}
                    {% if destinosRelacionados is not empty %}
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <h2 class="h6 text-uppercase text-muted mb-3">Destinos relacionados</h2>
                                <ul class="list-unstyled d-flex flex-column gap-3 mb-0">
                                    {% for relacionado in destinosRelacionados|slice(0,3) %}
                                        <li>
                                            <a class="d-flex gap-3 align-items-center text-decoration-none" href="{{ path('app_destino_show', {id: relacionado.id}) }}">
                                                <div class="flex-shrink-0">
                                                    {% if relacionado.imagenPrincipal %}
                                                        <img src="{{ asset('img/destinos/' ~ relacionado.imagenPrincipal) }}" class="rounded" style="width: 72px; height: 72px; object-fit: cover;" alt="{{ relacionado.nombre }}">
                                                    {% else %}
                                                        <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 72px; height: 72px;">
                                                            <span class="bi bi-image text-muted"></span>
                                                        </div>
                                                    {% endif %}
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-semibold text-dark">{{ relacionado.nombre }}</div>
                                                    {% if relacionado.descripcionCorta %}
                                                        <div class="small text-muted">{{ relacionado.descripcionCorta|u.truncate(70, '…') }}</div>
                                                    {% endif %}
                                                </div>
                                            </a>
                                        </li>
                                    {% endfor %}
                                </ul>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}
